---
import Icon from './Icon.astro';
import ProjectFlow from './ProjectFlow.astro';
import { aiProjects, experiments } from '../data/site';
import { resumeProjects } from '../data/resume';
---
<section id="ai-platforms" class="h-section" aria-labelledby="ai-title">
  <div class="h-grid">
    <h2 id="ai-title" class="h-label">AI platforms</h2>
    <div>
      <p class="section-intro">Open source, with the code on GitHub.</p>
      <div class="ai-grid">
        {aiProjects.map((project, index) => (
          <article id={project.id} class:list={['card', { featured: index === 0 }]}>
            <p class="role">{project.role}</p>
            <h3>{project.title}</h3>
            <p class="desc">{project.summary}</p>
            <ProjectFlow steps={project.flow} label={`${project.title} architecture flow: ${project.flow.join(' to ')}`} />
            <ul class="chip-list" aria-label="Technologies">{project.topics.map(topic => <li class="chip">{topic}</li>)}</ul>
            <p class="card-links">
              <a href={project.href} class="text-link">{project.linkLabel} <Icon name="arrow" size={16} /></a>
              <a href={project.repo} class="text-link" target="_blank" rel="noopener noreferrer">View code on GitHub <Icon name="external" size={14} /></a>
            </p>
          </article>
        ))}
        {experiments.map(project => (
          <article class="card">
            <p class="status"><span class="dot" aria-hidden="true"></span>In progress</p>
            <h3>{project.title}</h3>
            <p class="desc">{project.description}</p>
            <ProjectFlow steps={project.flow} label={`${project.title} architecture flow: ${project.flow.join(' to ')}`} />
            <p class="tags">{project.topics.join(' · ')}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<section id="project-portfolio" class="h-section" aria-labelledby="projects-title">
  <div class="h-grid">
    <h2 id="projects-title" class="h-label">Delivered · {resumeProjects.length}</h2>
    <div>
      <p class="section-intro">Production platforms I have designed and delivered: Kubernetes, infrastructure as code, GitOps, and secure software delivery.</p>
      <ol class="portfolio rule-top">
        {resumeProjects.map(project => (
          <li id={project.id} class="project">
            <div class="project-head">
              <p class="role">{project.role}</p>
              <h3>{project.title}</h3>
            </div>
            <div class="project-body">
              <p class="desc">{project.description}</p>
              <ProjectFlow steps={project.flow} label={`${project.title} architecture flow: ${project.flow.join(' to ')}`} />
              <ul class="chip-list" aria-label="Technologies">{project.topics.map(topic => <li class="chip">{topic}</li>)}</ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .section-intro { max-width: 60ch; margin-bottom: 28px; font-size: 16px; line-height: 1.7; color: var(--slate); }

  .ai-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .card { display: grid; align-content: start; gap: 14px; padding: 26px; border: 1px solid var(--rule); border-radius: 3px; background: var(--surface); }
  .card h3 { font-size: 20px; }
  .card.featured { grid-column: 1 / -1; gap: 16px; padding: 32px; border-color: color-mix(in srgb, var(--signal) 40%, var(--rule)); border-top: 3px solid var(--signal); }
  .card.featured h3 { font-size: 26px; letter-spacing: -.02em; }
  .card.featured .desc { max-width: 64ch; font-size: 16px; }
  .card:target { outline: 2px solid var(--signal); outline-offset: 4px; }
  .card-links { display: flex; flex-wrap: wrap; gap: 0 28px; }
  .card-links .text-link { margin-top: 0; }
  .status { display: inline-flex; align-items: center; gap: 8px; font: 400 12px/1.5 var(--font-utility); color: var(--slate); }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--live); }
  .tags { padding-top: 14px; border-top: 1px solid var(--rule); font-size: 13px; color: var(--slate); }

  .portfolio { margin: 0; padding: 0; list-style: none; }
  .project { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.4fr); gap: 40px; padding-block: 36px; border-bottom: 1px solid var(--rule); }
  .project:target { background: linear-gradient(90deg, var(--signal-soft), transparent 70%); }
  .role { font: 400 12px/1.5 var(--font-utility); color: var(--slate); }
  .project h3 { margin-top: 8px; font-size: 21px; line-height: 1.3; }
  .project-body { display: grid; gap: 18px; }
  .desc { font-size: 15px; line-height: 1.75; color: var(--slate); }

  @media (max-width: 760px) {
    .ai-grid { grid-template-columns: 1fr; }
    .card, .card.featured { padding: 22px; }
    .card.featured h3 { font-size: 23px; }
    .project { grid-template-columns: 1fr; gap: 14px; padding-block: 28px; }
  }
</style>
