---
import { projects } from '../data/site';
import Icon from './Icon.astro';
---
<section id="projects" class="section" aria-labelledby="projects-title">
  <div class="section-heading">
    <div><p class="eyebrow">Putting ideas into practice</p><h2 id="projects-title">Selected Projects</h2></div>
    <span class="section-note">A preview of what I'm exploring</span>
  </div>
  <div class="project-grid grid gap-5 md:grid-cols-3">
    {projects.map(project => (
      <article class="project-card flex flex-col">
        <div class="project-icon"><Icon name={project.icon} size={25} /></div>
        <h3>{project.title}</h3>
        <p>{project.description}</p>
        <ul class="project-tags flex flex-wrap gap-x-3 gap-y-2">{project.topics.map(topic => <li>{topic}</li>)}</ul>
      </article>
    ))}
  </div>
</section>
