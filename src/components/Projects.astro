---
import { projects } from '../data/site';
---
<section id="projects" class="section" aria-labelledby="projects-title">
  <div class="section-heading">
    <h2 id="projects-title">Selected Projects</h2>
    <span class="section-note">A preview of what I'm exploring</span>
  </div>
  <div class="project-grid grid gap-5 md:grid-cols-2">
    {projects.map((project, index) => (
      <article class:list={['project-card', { 'project-featured': index === 0 }]}>
        <div class="project-copy">
          <h3>{project.title}</h3>
          <p>{project.description}</p>
        </div>
        <ul class="project-tags flex flex-wrap gap-x-3 gap-y-2">{project.topics.map(topic => <li>{topic}</li>)}</ul>
      </article>
    ))}
  </div>
</section>
