---
import { projects } from '../data/site';
import { resumeProjects } from '../data/resume';
import Icon from './Icon.astro';
---
<section id="projects" class="section" aria-labelledby="projects-title">
  <div class="section-heading">
    <h2 id="projects-title">Selected Projects</h2>
    <span class="section-note">From my cloud, DevOps, and AI work</span>
  </div>
  <div class="project-grid grid gap-5 md:grid-cols-2">
    {resumeProjects.slice(0, 3).map((project, index) => (
      <article class:list={['project-card', { 'project-featured': index === 0 }]}>
        <div class="project-copy">
          <h3>{project.title}</h3>
          <p>{project.description}</p>
        </div>
        <ul class="project-tags flex flex-wrap gap-x-3 gap-y-2">{project.topics.map(topic => <li>{topic}</li>)}</ul>
      </article>
    ))}
  </div>
  <a href="/experience/#project-portfolio" class="text-link">View all {resumeProjects.length} projects <Icon name="arrow" size={17} /></a>
  <details class="upcoming-writing">
    <summary>Current experiments</summary>
    <div class="project-grid grid gap-5 md:grid-cols-2">
      {projects.map(project => <article class="project-card"><h3>{project.title}</h3><p>{project.description}</p><ul class="project-tags flex flex-wrap gap-x-3 gap-y-2">{project.topics.map(topic => <li>{topic}</li>)}</ul></article>)}
    </div>
  </details>
</section>
