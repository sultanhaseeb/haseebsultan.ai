---
import { projects } from '../data/site';
import { resumeProjects } from '../data/resume';
import ProjectFlow from './ProjectFlow.astro';
---
<section id="project-portfolio" class="h-section" aria-labelledby="projects-title">
  <div class="h-grid">
    <h2 id="projects-title" class="h-label">Delivered · {resumeProjects.length}</h2>
    <ol class="portfolio rule-top">
      {resumeProjects.map((project, index) => (
        <li id={`project-${index + 1}`} class="project">
          <div class="project-head">
            <p class="role">{project.role}</p>
            <h3>{project.title}</h3>
          </div>
          <div class="project-body">
            <p class="desc">{project.description}</p>
            <ProjectFlow steps={project.flow} label={`${project.title} architecture flow: ${project.flow.join(' to ')}`} />
            <ul class="chip-list" aria-label="Technologies">{project.topics.map(topic => <li class="chip">{topic}</li>)}</ul>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="h-section" aria-labelledby="experiments-title">
  <div class="h-grid">
    <h2 id="experiments-title" class="h-label">Experimenting</h2>
    <div>
      <p class="exp-intro">Ideas I'm building and testing now, around agents, MCP, and secure AI access to infrastructure.</p>
      <div class="experiments">
        {projects.map(project => (
          <article class="experiment">
            <p class="status"><span class="dot" aria-hidden="true"></span>In progress</p>
            <h3>{project.title}</h3>
            <p class="desc">{project.description}</p>
            <ProjectFlow steps={project.flow} label={`${project.title} architecture flow: ${project.flow.join(' to ')}`} />
            <p class="tags">{project.topics.join(' · ')}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .portfolio { margin: 0; padding: 0; list-style: none; }
  .project { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.4fr); gap: 40px; padding-block: 36px; border-bottom: 1px solid var(--rule); }
  .project:target { background: linear-gradient(90deg, var(--signal-soft), transparent 70%); }
  .role { font: 400 12px/1.5 var(--font-utility); color: var(--slate); }
  .project h3 { margin-top: 8px; font-size: 21px; line-height: 1.3; }
  .project-body { display: grid; gap: 18px; }
  .desc { font-size: 15px; line-height: 1.75; color: var(--slate); }
  .exp-intro { max-width: 60ch; font-size: 16px; line-height: 1.7; color: var(--slate); }
  .experiments { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin-top: 28px; }
  .experiment { display: grid; align-content: start; gap: 14px; padding: 26px; border: 1px solid var(--rule); border-radius: 3px; background: var(--surface); }
  .experiment h3 { font-size: 20px; }
  .status { display: inline-flex; align-items: center; gap: 8px; font: 400 12px/1.5 var(--font-utility); color: var(--slate); }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--live); }
  .tags { padding-top: 14px; border-top: 1px solid var(--rule); font-size: 13px; color: var(--slate); }
  @media (max-width: 760px) {
    .project { grid-template-columns: 1fr; gap: 14px; padding-block: 28px; }
    .experiments { grid-template-columns: 1fr; }
    .experiment { padding: 22px; }
  }
</style>
