---
import Icon from './Icon.astro';
import { site } from '../data/site';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="intro"><span aria-hidden="true" class="intro-line"></span>Hello, I'm Haseeb Sultan.</p>
    <h1 id="hero-title">AI Platform<br /><span>Engineer</span></h1>
    <p class="hero-description">I build the infrastructure behind reliable, secure AI systems.</p>
    <p class="hero-note">Based in Dubai, with a background in senior DevOps and AIOps engineering. I bring hands-on experience across Azure, AWS, Google Cloud, Kubernetes, and MLOps to my work on AI platforms.</p>
    <div class="hero-actions flex flex-wrap gap-3">
      <a href="/projects/" class="button button-primary">Explore My Work <Icon name="arrow" size={18} /></a>
      <a href={site.social.github} target="_blank" rel="noopener noreferrer" class="button button-secondary"><Icon name="github" size={18} /> GitHub</a>
    </div>
  </div>
  <figure class="portrait">
    <img src="/images/haseeb.jpg" alt="Haseeb Sultan smiling outdoors, wearing a navy blazer and white shirt" width="1254" height="1254" fetchpriority="high" decoding="async" />
  </figure>
</section>
