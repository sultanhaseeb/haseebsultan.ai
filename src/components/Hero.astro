---
import Icon from './Icon.astro';
import { site } from '../data/site';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="intro"><span aria-hidden="true" class="intro-line"></span>Hello, I'm Haseeb Sultan.</p>
    <h1 id="hero-title">Engineering <span>scalable, automated infrastructure</span> for the AI era.</h1>
    <p class="hero-description">I build secure platforms across cloud, Kubernetes, and AI turning complex infrastructure into reliable systems that teams can scale.</p>
    <ul class="hero-focus" aria-label="Areas of focus">
      <li>Cloud platforms</li>
      <li>Kubernetes</li>
      <li>AI infrastructure</li>
    </ul>
    <div class="hero-actions flex flex-wrap gap-3">
      <a href="/projects/" class="button button-primary">Explore My Work <Icon name="arrow" size={18} /></a>
      <a href={site.social.github} target="_blank" rel="noopener noreferrer" class="button button-secondary"><Icon name="github" size={18} /> GitHub</a>
    </div>
  </div>
  <figure class="portrait">
    <img src="/images/haseeb.jpg" alt="Haseeb Sultan smiling outdoors, wearing a navy blazer and white shirt" width="1254" height="1254" fetchpriority="high" decoding="async" />
    <figcaption>
      <strong>Senior DevOps / AIOps Engineer</strong>
      <span>Dubai, UAE</span>
    </figcaption>
  </figure>
</section>
