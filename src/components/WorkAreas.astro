---
import { workAreas } from '../data/site';
import Icon from './Icon.astro';
---
<section class="section work" aria-labelledby="work-title">
  <div class="section-heading"><h2 id="work-title">What I Work On</h2></div>
  <div class="work-grid grid sm:grid-cols-2 lg:grid-cols-4">
    {workAreas.map(area => (
      <article class="work-area">
        <Icon name={area.icon} size={24} />
        <h3>{area.title}</h3>
        <p>{area.description}</p>
      </article>
    ))}
  </div>
</section>
