---
import Icon from './Icon.astro';
import { site } from '../data/site';
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: 'Home', match: (p: string) => p === '/' },
  { href: '/writing/', label: 'Writing', match: (p: string) => p.startsWith('/writing') },
  { href: '/learning/', label: 'Learning', match: (p: string) => p.startsWith('/learning') },
  { href: '/projects/', label: 'Projects', match: (p: string) => p === '/projects' },
  { href: '/experience/', label: 'Experience', match: (p: string) => p === '/experience' },
  { href: '/about/', label: 'About', match: (p: string) => p === '/about' },
];
const ariaCurrent = (link: (typeof links)[number]) => {
  if (!link.match(currentPath)) return undefined;
  return currentPath === (link.href.replace(/\/$/, '') || '/') ? 'page' : 'location';
};
---
<header class="site-header">
  <div class="site-header-inner shell">
    <a href="/" class="wordmark" aria-label="Haseeb Sultan home"><span class="wordmark-mark" aria-hidden="true">HS</span>Haseeb Sultan</a>
    <nav class="site-nav" aria-label="Main navigation">
      {links.map(link => <a href={link.href} aria-current={ariaCurrent(link)}>{link.label}</a>)}
      <a href={site.social.github} target="_blank" rel="noopener noreferrer" class="nav-cta">GitHub <Icon name="external" size={14} /></a>
    </nav>
  </div>
</header>
