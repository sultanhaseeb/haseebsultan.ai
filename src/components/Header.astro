---
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
// Articles live under Blog; the lesson series and its lessons live under Lessons.
const links = [
  { href: '/', label: 'Home', match: (p: string) => p === '/' },
  { href: '/blog/', label: 'Blog', match: (p: string) => p.startsWith('/blog') },
  { href: '/learning/', label: 'Lessons', match: (p: string) => p.startsWith('/learning') },
  { href: '/projects/', label: 'Projects', match: (p: string) => p.startsWith('/projects') },
  { href: '/experience/', label: 'Experience', match: (p: string) => p === '/experience' },
  { href: '/about/', label: 'About', match: (p: string) => p === '/about' },
];
const ariaCurrent = (link: (typeof links)[number]) => {
  if (!link.match(currentPath)) return undefined;
  return currentPath === (link.href.replace(/\/$/, '') || '/') ? 'page' : 'location';
};
---
<header class="site-header">
  <div class="site-header-inner shell">
    <a href="/" class="wordmark">Haseeb Sultan<span class="dot" aria-hidden="true">.</span></a>
    <nav class="site-nav" aria-label="Main navigation">
      {links.map(link => <a href={link.href} aria-current={ariaCurrent(link)}>{link.label}</a>)}
      <a href="/#contact" class="nav-cta">Contact</a>
    </nav>
  </div>
</header>
