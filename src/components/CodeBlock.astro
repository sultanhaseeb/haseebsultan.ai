---
// A code sample with a filename and language bar, on the dark code background. Highlighting is Astro's <Code> (Shiki).
import { Code } from 'astro:components';
interface Props {
  code: string;
  lang: 'python' | 'bash' | 'yaml' | 'json' | 'go' | 'typescript';
  // Shown on the left of the bar, such as server.py or terminal.
  file?: string;
}
const { code, lang, file = lang === 'bash' ? 'terminal' : 'code' } = Astro.props;
---
<div class="code-block">
  <div class="code-bar"><span>{file}</span><span>{lang}</span></div>
  <Code code={code} lang={lang} theme="github-dark-default" />
</div>

<style>
  .code-block { min-width: 0; background: var(--code-bg); color: var(--code-ink); }
  .code-bar { display: flex; justify-content: space-between; gap: 16px; padding: 10px 18px; border-bottom: 1px solid var(--code-rule); font: 400 12px/1.5 var(--font-mono); color: var(--code-muted); }
  /* Shiki sets its own background inline; the code background token replaces it. */
  .code-block :global(pre) { margin: 0; padding: 18px; overflow-x: auto; background: var(--code-bg) !important; font: 14px/1.7 var(--font-mono); }
  .code-block :global(pre code) { padding: 0; background: none; font: inherit; }
</style>
