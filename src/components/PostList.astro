---
import Icon from './Icon.astro';
import PostCover from './PostCover.astro';
import { type Post, isLesson, postLabel } from '../data/blog';
import { formatDate } from '../utils/date';
interface Props {
  posts: Post[];
  label: string;
}
const { posts, label } = Astro.props;
---
<section class="h-section" aria-labelledby="posts-title">
  <div class="h-grid">
    <h2 id="posts-title" class="h-label">{label}</h2>
    <ol class="posts rule-top">
      {posts.map(post => (
        <li>
          <article class="entry">
            <a href={post.href} class="thumb" tabindex="-1" aria-hidden="true"><PostCover post={post} /></a>
            <div class="entry-copy">
              <p class="meta"><span>{postLabel(post)}</span><time datetime={post.published}>{formatDate(post.published)}</time></p>
              <h3><a href={post.href}>{post.title}</a></h3>
              <p class="desc">{post.description}</p>
              <a href={post.href} class="text-link">{isLesson(post) ? 'Start lesson' : 'Read article'}<span class="sr-only">: {post.title}</span> <Icon name="arrow" size={16} /></a>
            </div>
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .posts { margin: 0; padding: 0; list-style: none; }
  .posts > li { border-bottom: 1px solid var(--rule); }
  .entry { display: grid; grid-template-columns: minmax(0, 280px) minmax(0, 1fr); gap: 36px; align-items: start; padding-block: 32px; }
  .thumb { display: block; transition: opacity 160ms ease; }
  .entry:hover .thumb { opacity: .92; }
  .meta { display: flex; flex-wrap: wrap; gap: 4px 12px; font: 400 12px/1.5 var(--font-utility); color: var(--slate); }
  .meta span { color: var(--signal); }
  h3 { margin-top: 10px; font-size: 22px; line-height: 1.3; }
  h3 a:hover { color: var(--signal); }
  .desc { margin-top: 10px; max-width: 60ch; font-size: 15px; line-height: 1.7; color: var(--slate); }
  .text-link { margin-top: 8px; }
  @media (max-width: 680px) {
    .entry { grid-template-columns: 1fr; gap: 18px; padding-block: 26px; }
    .thumb { max-width: 420px; }
    h3 { font-size: 20px; }
  }
</style>
