---
// The blog listing: the newest article as the lead, then every other post in a card grid.
// The All / Articles / Lessons buttons filter the list in the browser and keep the choice in the URL (?type=).
// Without JavaScript the buttons stay hidden and every post shows.
import PostCover from './PostCover.astro';
import { type Post, isLesson, lessonNumber } from '../data/blog';
import { formatDate } from '../utils/date';
interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
const lead = posts.find(post => !isLesson(post));
const rest = posts.filter(post => post !== lead);
const kind = (post: Post) => (isLesson(post) ? 'lesson' : 'article');
const label = (post: Post) => (isLesson(post) ? `Lesson ${lessonNumber(post)}` : 'Article');
const filters = [
  { id: 'all', label: 'All posts' },
  { id: 'article', label: 'Articles' },
  { id: 'lesson', label: 'Lessons' },
];
---
<div class="post-filters shell" role="group" aria-label="Filter posts" data-filters hidden>
  {filters.map((filter, index) => (
    <button type="button" data-filter={filter.id} aria-pressed={index === 0 ? 'true' : 'false'}>{filter.label}</button>
  ))}
</div>

<div class="post-list shell" data-post-list>
  {lead && (
    <a href={lead.href} class="lead" data-kind="article">
      <PostCover post={lead} tone="forest" class="lead-cover" sizes="(max-width: 900px) calc(100vw - 40px), 640px" />
      <div class="lead-copy">
        <p class="meta"><span class="accent">Latest · Article</span><time datetime={lead.published}>{formatDate(lead.published)}</time></p>
        <h2 class="lead-title">{lead.title}</h2>
        <p class="lead-desc">{lead.description}</p>
        <span class="text-link">Read the article <span aria-hidden="true">→</span></span>
      </div>
    </a>
  )}

  <h2 class="sr-only">More posts</h2>
  <ul class="grid">
    {rest.map(post => (
      <li data-kind={kind(post)}>
        <article class="card">
          <a href={post.href} tabindex="-1" aria-hidden="true" class="card-cover"><PostCover post={post} /></a>
          <p class="meta"><span class="accent">{label(post)}</span><span>{post.category}</span><time datetime={post.published}>{formatDate(post.published)}</time></p>
          <h3><a href={post.href}>{post.title}</a></h3>
          <p class="desc">{post.description}</p>
        </article>
      </li>
    ))}
  </ul>
  <p class="empty" data-empty hidden>No posts here yet.</p>
</div>

<script>
  const group = document.querySelector<HTMLElement>('[data-filters]');
  const list = document.querySelector<HTMLElement>('[data-post-list]');
  if (group && list) {
    const buttons = [...group.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const items = [...list.querySelectorAll<HTMLElement>('[data-kind]')];
    const empty = list.querySelector<HTMLElement>('[data-empty]');
    const apply = (filter: string, push: boolean) => {
      buttons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.filter === filter)));
      items.forEach(item => { item.hidden = filter !== 'all' && item.dataset.kind !== filter; });
      if (empty) empty.hidden = items.some(item => !item.hidden);
      if (push) {
        const url = new URL(location.href);
        if (filter === 'all') url.searchParams.delete('type'); else url.searchParams.set('type', filter);
        history.replaceState(null, '', url);
      }
    };
    buttons.forEach(button => button.addEventListener('click', () => apply(button.dataset.filter ?? 'all', true)));
    const initial = new URLSearchParams(location.search).get('type');
    group.hidden = false;
    apply(buttons.some(button => button.dataset.filter === initial) ? initial! : 'all', false);
  }
</script>

<style>
  .post-filters { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 48px; }
  .post-filters button {
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid var(--chip-rule);
    border-radius: 999px;
    font-size: 14px;
    color: var(--ink);
    cursor: pointer;
    transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease;
  }
  .post-filters button:hover { border-color: var(--ink); }
  .post-filters button[aria-pressed='true'] { border-color: var(--ink); background: var(--ink); color: var(--paper); }

  .post-list { padding-top: 32px; }
  .lead { display: flex; flex-wrap: wrap; gap: 32px 56px; padding-block: 40px; border-top: 1px solid var(--ink); border-bottom: 1px solid var(--rule); color: var(--ink); }
  .lead :global(.lead-cover) { flex: 1.2 1 440px; }
  .lead-copy { flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; justify-content: center; }
  .lead-title { margin-top: 14px; font-size: clamp(36px, 3.6vw, 52px); line-height: 1.02; transition: color 160ms ease; }
  .lead:hover .lead-title { color: var(--emerald); }
  .lead-desc { margin-top: 16px; font-size: 17px; line-height: 1.7; color: var(--body); }
  .lead .text-link { margin-top: 12px; }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr)); gap: 48px 40px; margin: 40px 0 0; padding: 0; list-style: none; }
  .card { display: flex; flex-direction: column; }
  .card-cover { display: block; }
  .card .meta { margin-top: 20px; }
  .card h3 { margin-top: 10px; font-size: 30px; line-height: 1.08; }
  .card h3 a { color: var(--ink); }
  .card h3 a:hover { color: var(--emerald); }
  .desc { margin-top: 10px; font-size: 15px; line-height: 1.7; color: var(--body); }
  .empty { margin-top: 40px; color: var(--muted); }
</style>
