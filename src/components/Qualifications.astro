---
import { certifications, education } from '../data/resume';
import Icon from './Icon.astro';
---
<div class="qualifications-grid">
  <section id="education" class="section" aria-labelledby="education-title">
    <div class="section-heading">
      <div class="qualification-heading"><span class="heading-icon" aria-hidden="true"><Icon name="graduation" size={22} /></span><h2 id="education-title">Education</h2></div>
    </div>
    <div class="education-list">{education.map(item => <article><div class="education-logo"><img src={item.logo} alt="" width={item.logoWidth} height={item.logoHeight} loading="lazy" decoding="async" /></div><div><p class="eyebrow">{item.detail}</p><h3>{item.qualification}</h3><p>{item.institution}</p></div></article>)}</div>
  </section>
  <section id="credentials" class="section" aria-labelledby="credentials-title">
    <div class="section-heading">
      <div class="qualification-heading"><span class="heading-icon" aria-hidden="true"><Icon name="certificate" size={21} /></span><h2 id="credentials-title">Certifications &amp; Exams</h2></div>
    </div>
    <p class="qualification-note">As listed in my 2025 résumé.</p>
    <ul class="credential-list">{certifications.map(certification => <li><span class="credential-logo"><img src={certification.logo} alt="" width={certification.logoWidth} height={certification.logoHeight} loading="lazy" decoding="async" /></span><span><strong>{certification.title}</strong><small>{certification.issuer}</small></span></li>)}</ul>
  </section>
</div>
<style>
  .qualifications-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 48px; }
  .qualification-heading { display: flex; align-items: center; gap: 12px; }
  .heading-icon { display: inline-flex; align-items: center; justify-content: center; width: 42px; height: 42px; color: var(--color-accent); border: 1px solid #d5dfef; border-radius: 9px; background: #eef4fd; }
  .qualification-note { color: var(--color-muted); font-size: 14px; margin-bottom: 18px; }
  .credential-list { display: grid; gap: 10px; list-style: none; padding: 0; }
  .credential-list li { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 13px; align-items: center; min-height: 64px; padding: 10px 14px; line-height: 1.45; border: 1px solid var(--color-line); border-radius: 7px; background: white; }
  .credential-logo { display: flex; align-items: center; justify-content: center; width: 42px; height: 42px; padding: 6px; border: 1px solid #e2e6ec; border-radius: 8px; background: white; }
  .credential-logo img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .credential-list strong { display: block; font-size: 14px; font-weight: 550; }
  .credential-list small { display: block; margin-top: 3px; color: var(--color-muted); font-size: 12px; }
  .education-list article { display: grid; grid-template-columns: 74px minmax(0, 1fr); gap: 18px; align-items: start; padding-block: 20px; border-top: 1px solid var(--color-line); }
  .education-logo { display: flex; align-items: center; justify-content: center; width: 72px; height: 66px; padding: 7px; border: 1px solid #dfe4eb; border-radius: 9px; background: white; }
  .education-logo img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .education-list h3 { margin-top: 8px; }
  .education-list article > div:last-child > p:last-child { margin-top: 8px; line-height: 1.7; color: var(--color-muted); }
  @media (max-width: 767px) { .qualifications-grid { grid-template-columns: 1fr; gap: 0; } }
  @media (max-width: 479px) {
    .education-list article { grid-template-columns: 62px minmax(0, 1fr); gap: 14px; }
    .education-logo { width: 60px; height: 58px; padding: 6px; }
  }
</style>
