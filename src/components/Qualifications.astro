---
// Certifications and education, side by side, each with the issuer's logo in a white tile.
import { Image } from 'astro:assets';
import { certifications, education } from '../data/resume';
---
<section class="quals section shell" aria-label="Certifications and education">
  <div id="credentials" class="quals-col">
    <h2 class="sec-label">§ 03 · Certifications</h2>
    <ul class="creds rule-top">
      {certifications.map(item => (
        <li>
          <span class="tile"><Image src={item.logo} alt="" width={60} /></span>
          <div>
            <p class="cred-title">{item.title}</p>
            <p class="issuer">{item.issuer}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
  <div id="education" class="quals-col">
    <h2 class="sec-label">§ 04 · Education</h2>
    <ol class="edu rule-top">
      {education.map(item => (
        <li>
          <span class="tile tile-lg"><Image src={item.logo} alt="" width={104} /></span>
          <div>
            <h3>{item.qualification}</h3>
            <p class="inst">{item.institution} · {item.detail}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .quals { display: flex; flex-wrap: wrap; gap: 56px 72px; }
  .quals-col { flex: 1 1 480px; min-width: 0; scroll-margin-top: calc(var(--header-h) + 24px); }
  #education { flex-basis: 420px; }
  .sec-label { display: block; }
  .creds, .edu { margin: 28px 0 0; padding: 0; list-style: none; }
  .creds li { display: flex; align-items: center; gap: 18px; padding-block: 16px; border-bottom: 1px solid var(--rule); }
  .edu li { display: flex; align-items: center; gap: 20px; padding-block: 20px; border-bottom: 1px solid var(--rule); }
  .creds li > div, .edu li > div { flex: 1 1 auto; min-width: 0; }
  .tile { flex: 0 0 52px; display: grid; place-items: center; width: 52px; height: 52px; padding: 11px; border: 1px solid var(--rule); background: var(--tile); }
  .tile-lg { flex-basis: 72px; width: 72px; height: 72px; padding: 10px; }
  .tile :global(img) { width: 100%; height: 100%; object-fit: contain; }
  .cred-title { font-size: 16px; font-weight: 500; line-height: 1.45; }
  .issuer { margin-top: 3px; font: 400 12px/1.5 var(--font-mono); color: var(--muted); }
  .edu h3 { font-size: 26px; line-height: 1.15; }
  .inst { margin-top: 6px; font-size: 14px; line-height: 1.6; color: var(--body); }
</style>
