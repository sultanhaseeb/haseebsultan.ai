---
import { certifications, education } from '../data/resume';
import Icon from './Icon.astro';
---
<div class="qualifications-grid">
  <section id="education" class="section" aria-labelledby="education-title">
    <div class="section-heading">
      <div class="qualification-heading"><span class="heading-icon" aria-hidden="true"><Icon name="graduation" size={22} /></span><h2 id="education-title">Education</h2></div>
    </div>
    <div class="education-list">{education.map(item => <article><div class="education-mark" aria-hidden="true">{item.mark}</div><div><p class="eyebrow">{item.detail}</p><h3>{item.qualification}</h3><p>{item.institution}</p></div></article>)}</div>
  </section>
  <section id="credentials" class="section" aria-labelledby="credentials-title">
    <div class="section-heading">
      <div class="qualification-heading"><span class="heading-icon" aria-hidden="true"><Icon name="certificate" size={21} /></span><h2 id="credentials-title">Certifications &amp; Exams</h2></div>
    </div>
    <p class="qualification-note">As listed in my 2025 résumé.</p>
    <ul class="credential-list">{certifications.map(certification => <li><span class="credential-icon" aria-hidden="true"><Icon name="certificate" size={17} /></span><span>{certification}</span></li>)}</ul>
  </section>
</div>
<style>
  .qualifications-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 48px; }
  .qualification-heading { display: flex; align-items: center; gap: 12px; }
  .heading-icon { display: inline-flex; align-items: center; justify-content: center; width: 42px; height: 42px; color: var(--color-accent); border: 1px solid #d5dfef; border-radius: 9px; background: #eef4fd; }
  .qualification-note { color: var(--color-muted); font-size: 14px; margin-bottom: 18px; }
  .credential-list { display: grid; gap: 10px; list-style: none; padding: 0; }
  .credential-list li { display: grid; grid-template-columns: 32px minmax(0, 1fr); gap: 12px; align-items: center; min-height: 54px; padding: 10px 14px; line-height: 1.55; border: 1px solid var(--color-line); border-radius: 7px; background: white; }
  .credential-icon { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; color: var(--color-accent); border-radius: 50%; background: #eef4fd; }
  .education-list article { display: grid; grid-template-columns: 54px minmax(0, 1fr); gap: 16px; align-items: start; padding-block: 20px; border-top: 1px solid var(--color-line); }
  .education-mark { display: flex; align-items: center; justify-content: center; width: 52px; height: 52px; color: #315789; font: 12px/1 var(--font-mono); font-weight: 650; letter-spacing: .03em; border: 1px solid #d5dfef; border-radius: 9px; background: #f0f5fc; }
  .education-list h3 { margin-top: 8px; }
  .education-list article > div:last-child > p:last-child { margin-top: 8px; line-height: 1.7; color: var(--color-muted); }
  @media (max-width: 767px) { .qualifications-grid { grid-template-columns: 1fr; gap: 0; } }
  @media (max-width: 479px) {
    .education-list article { grid-template-columns: 46px minmax(0, 1fr); gap: 13px; }
    .education-mark { width: 44px; height: 44px; font-size: 11px; }
  }
</style>
