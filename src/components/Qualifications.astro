---
import { certifications, education } from '../data/resume';
---
<div class="qualifications-grid">
  <section id="education" class="section" aria-labelledby="education-title">
    <div class="section-heading"><h2 id="education-title">Education</h2></div>
    <div class="education-list">{education.map(item => <article><p class="eyebrow">{item.detail}</p><h3>{item.qualification}</h3><p>{item.institution}</p></article>)}</div>
  </section>
  <section id="credentials" class="section" aria-labelledby="credentials-title">
    <div class="section-heading"><h2 id="credentials-title">Certifications &amp; Exams</h2></div>
    <p class="qualification-note">As listed in my 2025 résumé.</p>
    <ul class="credential-list">{certifications.map(certification => <li>{certification}</li>)}</ul>
  </section>
</div>
<style>
  .qualifications-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 48px; }
  .qualification-note { color: var(--color-muted); font-size: 14px; margin-bottom: 18px; }
  .credential-list { list-style: disc; padding-inline-start: 20px; line-height: 1.8; }
  .credential-list li { padding-bottom: 16px; }
  .education-list article { padding-block: 20px; border-top: 1px solid var(--color-line); }
  .education-list h3 { margin-top: 8px; }
  .education-list article > p:last-child { margin-top: 8px; line-height: 1.7; color: var(--color-muted); }
  @media (max-width: 767px) { .qualifications-grid { grid-template-columns: 1fr; gap: 0; } }
</style>
