---
import { site } from '../../data/site';
import { profile } from '../../data/resume';

const channels = [
  { label: 'Email', value: profile.email, href: site.social.email },
  { label: 'LinkedIn', value: 'Connect and message', href: site.social.linkedin, external: true },
  { label: 'Topmate', value: 'Book a one-to-one session', href: site.social.topmate, external: true },
  { label: 'GitHub', value: 'sultanhaseeb', href: site.social.github, external: true },
];
---
<section id="contact" class="contact shell" aria-labelledby="contact-title">
  <p class="sec-label">§ 05 · Contact</p>
  <h2 id="contact-title">Working on cloud, Kubernetes, or LLM infrastructure? <em>Let's talk.</em></h2>
  <div class="ruled rows channels">
    <ul class="ruled-grid">
      {channels.map(channel => (
        <li>
          <a href={channel.href} target={channel.external ? '_blank' : undefined} rel={channel.external ? 'noopener noreferrer' : undefined}>
            <span class="mono-label">{channel.label}</span>
            <span class="value">{channel.value}{channel.external && <span aria-hidden="true"> ↗</span>}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .contact { padding-block: clamp(96px, 12vw, 140px) var(--section-gap); }
  h2 { margin-top: 20px; max-width: 18ch; font-size: clamp(48px, 7vw, 104px); line-height: .98; letter-spacing: -.025em; }
  .channels { margin-top: 56px; }
  .channels .ruled-grid { --cell-min: 240px; --cell-pad: 20px; }
  .channels a { display: flex; flex-direction: column; gap: 6px; padding-block: 22px; color: var(--ink); }
  .value { font-size: 16px; font-weight: 500; overflow-wrap: anywhere; }
  .channels a:hover .value { color: var(--emerald); }
</style>
