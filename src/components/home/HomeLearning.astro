---
import Icon from '../Icon.astro';
import { learningLessons } from '../../data/writing';
import { formatDate } from '../../utils/date';

const latest = learningLessons[learningLessons.length - 1];
const number = String(learningLessons.length).padStart(2, '0');
---
<section id="learning" class="h-section shell" aria-labelledby="learning-title">
  <div class="h-grid">
    <p class="h-label">Learning</p>
    <div>
      <h2 id="learning-title" class="h-title">Let's learn together.</h2>
      <p class="intro">I'm learning LLMOps and AI engineering in public, and I write up each topic as a lesson you can follow along with.</p>
      <a href={latest.href} class="lesson">
        <span class="no" aria-hidden="true">{number}</span>
        <span class="copy">
          <span class="meta">Latest lesson · {formatDate(latest.published)}</span>
          <span class="title">{latest.title}</span>
          <span class="desc">{latest.description}</span>
        </span>
        <span class="go" aria-hidden="true"><Icon name="arrow" size={18} /></span>
      </a>
      <a href="/learning/" class="h-more">All lessons <Icon name="arrow" size={16} /></a>
    </div>
  </div>
</section>

<style>
  .intro { margin-top: 14px; max-width: 58ch; font-size: 16px; line-height: 1.7; color: var(--slate); }
  .lesson { display: grid; grid-template-columns: 64px minmax(0, 1fr) 24px; gap: 24px; align-items: center; margin-top: 28px; padding: 26px 28px; border: 1px solid var(--rule); border-radius: 3px; background: var(--surface); transition: border-color 160ms ease; }
  .lesson:hover { border-color: var(--ink); }
  .no { font-family: var(--font-display); font-weight: 600; font-size: 40px; line-height: 1; letter-spacing: -.03em; color: var(--signal); }
  .copy { display: grid; gap: 6px; }
  .meta { font: 400 12px/1.5 var(--font-utility); color: var(--slate); }
  .title { font-family: var(--font-display); font-weight: 600; font-size: 20px; line-height: 1.3; color: var(--ink); }
  .desc { font-size: 15px; line-height: 1.65; color: var(--slate); }
  .go { color: var(--slate); transition: color 160ms ease, translate 160ms ease; }
  .lesson:hover .title, .lesson:hover .go { color: var(--signal); }
  .lesson:hover .go { translate: 3px 0; }
  @media (max-width: 600px) {
    .lesson { grid-template-columns: 1fr; gap: 12px; padding: 22px; }
    .no { font-size: 30px; }
    .go { display: none; }
  }
</style>
