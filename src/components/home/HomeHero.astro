---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import portrait from '../../assets/images/haseeb.jpg';
import { site } from '../../data/site';
import { profile } from '../../data/resume';

// Career start (June 2019). Counted at build time, so the figure rises after each anniversary once the site is rebuilt.
const careerStart = new Date(Date.UTC(2019, 5, 1));
const now = new Date();
const yearsOfExperience = now.getUTCFullYear() - careerStart.getUTCFullYear() - (now.getUTCMonth() < careerStart.getUTCMonth() ? 1 : 0);

const facts = [
  { label: 'Experience', value: `${yearsOfExperience}+ years`, big: true },
  { label: 'Clouds', value: 'Azure, AWS, Google Cloud' },
  { label: 'Certified', value: 'Kubernetes Administrator (CKA), Azure DevOps Engineer Expert' },
  { label: 'Focus now', value: 'LLMOps, agent infrastructure, AI security' },
];
---
<section class="home-hero shell" aria-labelledby="hero-title">
  <div class="kicker-strip">
    <span>{site.title}</span>
    <span>{profile.location}</span>
    <span>Since {careerStart.getUTCFullYear()}</span>
  </div>
  <div class="hero-main">
    <div class="copy">
      <h1 id="hero-title">I build the infrastructure <em>AI runs on.</em></h1>
      <p class="lede">Since 2019 I've built cloud and Kubernetes platforms across Azure, AWS, and Google Cloud. Now I focus on what AI systems need underneath: LLMOps, agent infrastructure, and AI security.</p>
      <div class="btn-row actions">
        <a href="/projects/" class="btn btn-primary">See selected work <Icon name="arrow" size={17} /></a>
        <a href="#contact" class="btn btn-secondary">Get in touch</a>
      </div>
    </div>
    <figure class="photo">
      <Image
        src={portrait}
        alt="Haseeb Sultan smiling outdoors, wearing a navy blazer and white shirt"
        widths={[360, 400, 800]}
        sizes="(max-width: 440px) calc(100vw - 40px), 400px"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>{site.name}, Dubai</figcaption>
    </figure>
  </div>
  <div class="ruled rows facts">
    <dl class="ruled-grid">
      {facts.map(fact => (
        <div>
          <dt class="mono-label">{fact.label}</dt>
          <dd class:list={{ big: fact.big }}>{fact.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .home-hero { padding-top: clamp(48px, 7vw, 96px); }
  .hero-main { display: flex; flex-wrap: wrap; align-items: stretch; gap: 48px 72px; margin-top: 48px; }
  .copy { flex: 999 1 560px; min-width: 0; display: flex; flex-direction: column; }
  .lede { margin-top: 36px; max-width: 52ch; font-size: 19px; line-height: 1.65; color: var(--body); }
  .actions { gap: 14px; margin-top: 36px; }
  .photo { flex: 1 1 300px; max-width: 400px; }
  .photo :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 30%; background: var(--placeholder); }
  .photo figcaption { margin-top: 12px; font: 400 12px/1.5 var(--font-mono); color: var(--muted); }

  .facts { margin-top: 64px; }
  .facts .ruled-grid > div { padding-block: 24px; }
  .facts dd { margin-top: 10px; font-size: 15px; line-height: 1.55; font-weight: 500; }
  .facts dd.big { margin-top: 8px; font-family: var(--font-serif); font-size: 40px; font-weight: 400; line-height: 1; }

  @media (max-width: 560px) {
    .lede { font-size: 17px; }
  }
</style>
