---
import { aiProjects } from '../../data/site';
import { resumeProjects } from '../../data/resume';

// The flagship AI project, then two delivered platforms, chosen by id.
const selectedIds = ['aws-microservices-platform', 'on-premises-to-azure-migration'];
const [flagship] = aiProjects;
const delivered = selectedIds.map(id => {
  const project = resumeProjects.find(candidate => candidate.id === id);
  if (!project) throw new Error(`Unknown selected project: ${id}`);
  return {
    ...project,
    summary: `${project.description.split('. ')[0].replace(/\.$/, '')}.`,
    href: `/projects/#${project.id}`,
  };
});
const projectCount = aiProjects.length + resumeProjects.length;
// The agent is the step the flagship is about, so its pill is filled.
const highlight = (step: string) => /agent/i.test(step);
---
<section id="projects" class="section shell" aria-labelledby="projects-title">
  <div class="sec-head">
    <p class="sec-label">§ 03 · Selected projects</p>
    <h2 id="projects-title">Platforms I have designed and delivered.</h2>
  </div>
  <div class="ruled rows projects">
    <ul class="ruled-grid">
      <li class="flagship">
        <a href={flagship.href} class="card">
          <div class="flagship-copy">
            <p class="role">Flagship · {flagship.role}</p>
            <h3>{flagship.title}</h3>
            <p class="summary">{flagship.summary}</p>
          </div>
          <ol class="flow" aria-label={`${flagship.title} request path`}>
            {flagship.flow.map((step, i) => (
              <li>
                <span class:list={['pill', { on: highlight(step) }]}>{step}</span>
                {i < flagship.flow.length - 1 && <span class="arrow" aria-hidden="true">→</span>}
              </li>
            ))}
          </ol>
        </a>
      </li>
      {delivered.map(project => (
        <li>
          <a href={project.href} class="card">
            <p class="role muted">{project.role}</p>
            <h3>{project.title}</h3>
            <p class="summary">{project.summary}</p>
            <p class="topics">{project.topics.slice(0, 5).join(' · ')}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
  <a href="/projects/" class="text-link more">All {projectCount} projects <span aria-hidden="true">→</span></a>
</section>

<style>
  .projects { margin-top: 56px; }
  .projects .ruled-grid { --cell-min: 460px; --cell-pad: 40px; }
  .flagship { grid-column: 1 / -1; }
  .card { display: flex; flex-direction: column; gap: 12px; height: 100%; padding-block: 36px; color: var(--ink); }
  .flagship .card { flex-flow: row wrap; gap: 32px 56px; padding-block: 40px; }
  .flagship-copy { flex: 1 1 460px; min-width: 0; }
  .flagship .flow { flex: 1 1 340px; align-self: center; }
  .role { font: 400 12px/1.5 var(--font-mono); color: var(--emerald); }
  .role.muted { color: var(--muted); }
  h3 { font-size: 36px; line-height: 1.05; transition: color 160ms ease; }
  .flagship h3 { margin-top: 12px; font-size: 56px; line-height: 1; }
  .summary { font-size: 15px; line-height: 1.7; color: var(--body); }
  .flagship .summary { margin-top: 16px; max-width: 56ch; font-size: 17px; }
  .topics { margin-top: 4px; font-size: 13px; color: var(--muted); }
  .card:hover h3 { color: var(--emerald); }
  .more { margin-top: 20px; }
</style>
