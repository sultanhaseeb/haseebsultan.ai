---
import { platformLayers } from '../../data/site';
---
<section class="band stack-band" aria-labelledby="stack-title">
  <div class="band-inner shell">
    <div class="sec-head">
      <p class="sec-label">§ 01 · Platform stack</p>
      <div>
        <h2 id="stack-title">I started at the bottom of the stack. <em>Now I work at the top.</em></h2>
        <p class="sec-intro">Every AI system runs on cloud, orchestration, and delivery. I have spent years in each of those layers, and that work shapes how I build platforms for AI.</p>
      </div>
    </div>

    <ol class="stack" aria-label="Platform layers, from top to bottom">
      {platformLayers.map(layer => (
        <li class:list={['layer', { current: layer.current }]}>
          <div class="layer-head">
            <span class="layer-no" aria-hidden="true">{layer.id}</span>
            <div>
              <h3>{layer.name}</h3>
              <p class="since">{layer.since}</p>
            </div>
          </div>
          <p class="tools"><span class="sr-only">Tools: </span>{layer.tools.join(' · ')}</p>
          <div class="proof">
            <p>{layer.proof}</p>
            {layer.link && <a href={layer.link.href} class="text-link">{layer.link.label} <span aria-hidden="true">→</span></a>}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .stack-band { margin-top: var(--section-gap); }
  .stack { margin: 56px 0 0; padding: 0; list-style: none; border-top: 1px solid var(--forest-ink); }
  .layer { display: flex; flex-wrap: wrap; gap: 16px 40px; padding-block: 32px; border-bottom: 1px solid var(--forest-rule); }
  .layer-head { flex: 1 1 200px; display: flex; align-items: baseline; gap: 18px; }
  .layer-no { font-family: var(--font-serif); font-size: 56px; line-height: 1; color: var(--forest-numeral); }
  .layer h3 { font-family: var(--font-sans); font-size: 18px; font-weight: 600; line-height: 1.35; }
  .since { margin-top: 4px; font: 400 12px/1.5 var(--font-mono); color: var(--forest-muted); }
  .tools { flex: 2 1 320px; font: 400 13px/1.9 var(--font-mono); color: var(--forest-body); }
  .proof { flex: 2 1 320px; font-size: 16px; line-height: 1.65; color: var(--forest-body); }
  .proof .text-link { margin-top: 6px; min-height: 40px; font-size: 14px; }

  .layer.current .layer-no, .layer.current .since { color: var(--mint); }
  .layer.current .tools, .layer.current .proof { color: var(--forest-ink); }
</style>
