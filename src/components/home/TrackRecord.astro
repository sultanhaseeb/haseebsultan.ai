---
const metrics = [
  { value: '45%', unit: 'up to', label: 'Azure infrastructure cost reduction', accent: true },
  { value: '23+', label: 'Microservices with DevSecOps in CI/CD' },
  { value: '100+', label: 'Virtual machines migrated to Azure' },
  { value: '10+', label: 'DevOps projects led, with a team of 8' },
];

// Newest first. Focus lines are short versions of the roles on /experience/.
const roles = [
  { role: 'Senior DevOps Engineer', focus: 'AWS platform automation', dates: 'Feb 2025 – present', current: true },
  { role: 'Senior DevOps Engineer', focus: 'Azure optimization and DevSecOps', dates: 'Oct 2023 – Feb 2025' },
  { role: 'Senior DevOps Engineer', focus: 'Cloud migrations and team lead', dates: 'Oct 2020 – Oct 2023' },
  { role: 'Cloud / Full Stack Engineer', focus: 'React, Node.js, MySQL', dates: 'Jun 2019 – Sep 2020' },
];
---
<section id="experience" class="section shell" aria-labelledby="record-title">
  <div class="sec-head">
    <p class="sec-label">§ 02 · Track record</p>
    <h2 id="record-title">Measured results from production platforms.</h2>
  </div>

  <div class="ruled metrics">
    <dl class="ruled-grid">
      {metrics.map(metric => (
        <div class="metric">
          <dt>{metric.label}</dt>
          <dd class:list={{ accent: metric.accent }}>{metric.unit && <span class="unit">{metric.unit} </span>}{metric.value}</dd>
        </div>
      ))}
    </dl>
  </div>

  <ol class="roles" aria-label="Roles, newest first">
    {roles.map(item => (
      <li>
        <span class:list={['dates', { current: item.current }]}>{item.dates}</span>
        <strong class="serif">{item.role}</strong>
        <span class="focus">{item.focus}</span>
      </li>
    ))}
  </ol>
  <a href="/experience/" class="text-link more">Full experience and skills <span aria-hidden="true">→</span></a>
</section>

<style>
  .metrics { margin-top: 56px; }
  .metrics .ruled-grid { --cell-min: 240px; }
  .metric { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 12px; padding-top: 28px; }
  .metric dt { max-width: 22ch; font-size: 15px; line-height: 1.5; color: var(--body); }
  .metric dd { font-family: var(--font-serif); font-size: 96px; line-height: .9; letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
  .metric dd.accent { color: var(--emerald); }
  .unit { vertical-align: top; font: 400 12px/1.5 var(--font-mono); letter-spacing: 0; color: var(--muted); }

  .roles { margin: 72px 0 0; padding: 0; list-style: none; border-top: 1px solid var(--ink); }
  .roles li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 32px; padding-block: 22px; border-bottom: 1px solid var(--rule); }
  .dates { flex: 0 0 200px; font: 400 13px/1.5 var(--font-mono); color: var(--muted); }
  .dates.current { color: var(--emerald); }
  .roles strong { flex: 1 1 260px; font-size: 28px; line-height: 1.1; }
  .focus { flex: 1 1 260px; font-size: 15px; color: var(--body); }
  .more { margin-top: 20px; }

  @media (max-width: 560px) {
    .metric dd { font-size: 80px; }
    .dates { flex-basis: 100%; }
  }
</style>
