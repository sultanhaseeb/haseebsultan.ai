---
interface Props {
  name: 'arrow' | 'external';
  size?: number;
  class?: string;
}
const { name, size = 20, class: className } = Astro.props;
const paths = {
  arrow: 'M4 12h16m-6-6 6 6-6 6',
  external: 'M7 17 17 7M7 7h10v10',
};
---
<svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true"><path d={paths[name]} /></svg>
