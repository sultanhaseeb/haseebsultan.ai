---
import { formatDate } from '../utils/date';
import Icon from './Icon.astro';
import { writingArticles } from '../data/writing';

const articles = [...writingArticles].sort((a, b) => b.published.localeCompare(a.published));
---
<section class="h-section" aria-labelledby="writing-title">
  <div class="h-grid">
    <h2 id="writing-title" class="h-label">Articles · {articles.length}</h2>
    <ol class="articles rule-top">
      {articles.map(article => (
        <li>
          <article class="entry">
            <a href={article.href} class="thumb" tabindex="-1" aria-hidden="true">
              <img src={article.image} alt="" width={article.imageWidth} height={article.imageHeight} loading="lazy" decoding="async" style={`object-position: ${article.imagePosition}`} />
            </a>
            <div class="entry-copy">
              <p class="meta"><span>{article.category}</span><time datetime={article.published}>{formatDate(article.published)}</time></p>
              <h3><a href={article.href}>{article.title}</a></h3>
              <p class="desc">{article.description}</p>
              <a href={article.href} class="text-link" aria-label={`Read ${article.title}`}>Read article <Icon name="arrow" size={16} /></a>
            </div>
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .articles { margin: 0; padding: 0; list-style: none; }
  .articles li { border-bottom: 1px solid var(--rule); }
  .entry { display: grid; grid-template-columns: minmax(0, 300px) minmax(0, 1fr); gap: 36px; align-items: start; padding-block: 32px; }
  .thumb { display: block; aspect-ratio: 16 / 10; max-width: 100%; overflow: hidden; border: 1px solid var(--rule); border-radius: 2px; background: var(--surface); }
  .thumb img { display: block; width: 100%; height: 100%; object-fit: cover; transition: scale 400ms ease; }
  .entry:hover .thumb img { scale: 1.03; }
  .meta { display: flex; flex-wrap: wrap; gap: 12px; font: 400 12px/1.5 var(--font-utility); color: var(--slate); }
  .meta span { color: var(--signal); }
  h3 { margin-top: 10px; font-size: 22px; line-height: 1.3; }
  h3 a:hover { color: var(--signal); }
  .desc { margin-top: 10px; max-width: 60ch; font-size: 15px; line-height: 1.7; color: var(--slate); }
  .text-link { margin-top: 8px; }
  @media (max-width: 680px) {
    .entry { grid-template-columns: 1fr; gap: 18px; padding-block: 26px; }
    h3 { font-size: 20px; }
  }
</style>
