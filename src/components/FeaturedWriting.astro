---
import { articles } from '../data/site';
import { writingArticles } from '../data/writing';
import Icon from './Icon.astro';
interface Props { preview?: boolean; }
const { preview = false } = Astro.props;
const displayedArticles = preview ? writingArticles.slice(0, 2) : writingArticles;
---
<section id="writing" class="section writing" aria-labelledby="writing-title">
  <div class="section-heading">
    <h2 id="writing-title">{preview ? 'Featured Writing' : 'Published Articles'}</h2>
  </div>
  <div class="article-list">
    {displayedArticles.map((article, index) => (
      <article class="article-row">
        <span class="article-number" aria-hidden="true">0{index + 1}</span>
        <div class="article-content">
          <div class="article-meta flex items-center gap-3"><span>{article.category}</span><span class="meta-separator" aria-hidden="true">/</span><span>Published on {article.publication}</span></div>
          <h3><a class="article-title-link" href={article.href}>{article.title}</a></h3>
        </div>
      </article>
    ))}
  </div>
  {preview ? <a href="/writing/" class="text-link" aria-label="Explore more writing">Explore more <Icon name="arrow" size={17} /></a> : <details class="upcoming-writing">
    <summary>Upcoming writing</summary>
    <div class="article-list">
    {articles.map((article, index) => (
      <article class="article-row">
        <span class="article-number" aria-hidden="true">0{index + 1}</span>
        <div class="article-content">
          <div class="article-meta flex items-center gap-3"><span>{article.category}</span><span class="meta-separator" aria-hidden="true">/</span><span class="coming-soon">Coming soon</span></div>
          <h3>{article.title}</h3>
          <p>{article.description}</p>
        </div>
      </article>
    ))}
    </div>
  </details>}
</section>
