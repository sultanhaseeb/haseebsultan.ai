---
import { articles } from '../data/site';
---
<section id="writing" class="section writing" aria-labelledby="writing-title">
  <div class="section-heading">
    <h2 id="writing-title">Featured Writing</h2>
  </div>
  <div class="article-list">
    {articles.map((article, index) => (
      <article class="article-row">
        <span class="article-number" aria-hidden="true">0{index + 1}</span>
        <div class="article-content">
          <div class="article-meta flex items-center gap-3"><span>{article.category}</span><span class="meta-separator" aria-hidden="true">/</span><span class="coming-soon">Coming soon</span></div>
          <h3>{article.title}</h3>
          <p>{article.description}</p>
        </div>
      </article>
    ))}
  </div>
</section>
