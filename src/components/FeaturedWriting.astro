---
import { articles } from '../data/site';
import { writingArticles } from '../data/writing';
import Icon from './Icon.astro';
interface Props { preview?: boolean; }
const { preview = false } = Astro.props;
const displayedArticles = preview ? writingArticles.slice(0, 2) : writingArticles;
---
<section id="writing" class="section writing" aria-labelledby="writing-title">
  <div class="section-heading">
    <h2 id="writing-title">{preview ? 'Featured Writing' : 'Published Articles'}</h2>
  </div>
  <div class="article-list">
    {displayedArticles.map((article, index) => article.format === 'featured' ? (
      <article class="book-preview">
        <a href={article.href} class="book-preview-cover" aria-label={`Read ${article.title}`}>
          <img src={article.image} alt={article.imageAlt} width={article.imageWidth} height={article.imageHeight} style={`object-position: ${article.imagePosition};`} loading="lazy" decoding="async" />
        </a>
        <div class="book-preview-copy">
          <p class="article-meta">{article.category} · Published on {article.publication}</p>
          <h3><a class="article-title-link" href={article.href}>{article.title}</a></h3>
          <p class="book-preview-summary">{article.description}</p>
          <a href={article.href} class="text-link" aria-label={`Read ${article.title}`}>Read article <Icon name="arrow" size={17} /></a>
        </div>
      </article>
    ) : (
      <article class="article-row">
        <span class="article-number" aria-hidden="true">0{index + 1}</span>
        <div class="article-content">
          <div class="article-meta flex items-center gap-3"><span>{article.category}</span><span class="meta-separator" aria-hidden="true">/</span><span>Published on {article.publication}</span></div>
          <h3><a class="article-title-link" href={article.href}>{article.title}</a></h3>
        </div>
      </article>
    ))}
  </div>
  {preview ? <a href="/writing/" class="text-link" aria-label="Explore more writing">Explore more <Icon name="arrow" size={17} /></a> : <details class="upcoming-writing">
    <summary>Upcoming writing</summary>
    <div class="article-list">
    {articles.map((article, index) => (
      <article class="article-row">
        <span class="article-number" aria-hidden="true">0{index + 1}</span>
        <div class="article-content">
          <div class="article-meta flex items-center gap-3"><span>{article.category}</span><span class="meta-separator" aria-hidden="true">/</span><span class="coming-soon">Coming soon</span></div>
          <h3>{article.title}</h3>
          <p>{article.description}</p>
        </div>
      </article>
    ))}
    </div>
  </details>}
</section>

<style>
  .book-preview { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 30px; align-items: center; padding-block: 30px; border-bottom: 1px solid var(--color-line); }
  .book-preview-cover { display: block; border: 1px solid var(--color-line); border-radius: 8px; overflow: hidden; background: white; }
  .book-preview-cover { aspect-ratio: 16 / 9; }
  .book-preview-cover img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .book-preview h3 { font-size: 23px; line-height: 1.4; }
  .book-preview-summary { color: var(--color-muted); font-size: 15px; line-height: 1.8; margin-top: 12px; }
  .book-preview .text-link { margin-top: 12px; }
  @media (max-width: 767px) {
    .book-preview { grid-template-columns: 1fr; gap: 20px; }
    .book-preview h3 { font-size: 21px; }
  }
</style>
