---
// Three turns in the career so far, oldest first. The current one is in emerald.
const turns = [
  { year: '2019', title: 'Full-stack developer', text: 'Building products with React, Node.js, and MySQL in Agile teams.' },
  { year: '2020', title: 'DevOps and cloud platforms', text: 'Migrations, Kubernetes, delivery pipelines, and security across Azure, AWS, and Google Cloud.' },
  { year: 'Now', title: 'AI platforms', text: 'LLMOps, agent infrastructure, and AI security: taking AI from experiment to production.', current: true },
];
---
<section id="journey" class="section shell" aria-labelledby="journey-title">
  <div class="sec-head">
    <p class="sec-label">§ 03 · Journey</p>
    <h2 id="journey-title">Three turns, so far.</h2>
  </div>
  <div class="ruled rows path">
    <ol class="ruled-grid" aria-label="Career path">
      {turns.map(turn => (
        <li>
          <p class:list={['year serif', { current: turn.current }]}>{turn.year}</p>
          <h3>{turn.title}</h3>
          <p class="text">{turn.text}</p>
        </li>
      ))}
    </ol>
  </div>
  <a href="/experience/" class="text-link more">Certifications, education, and full experience <span aria-hidden="true">→</span></a>
</section>

<style>
  .path { margin-top: 48px; }
  .path .ruled-grid { --cell-min: 280px; --cell-pad: 28px; }
  .path li { padding-block: 28px 32px; }
  /* Past years are real text, so they use --soon (3:1 at this size) rather than the decorative --faint. */
  .year { font-size: 72px; line-height: 1; color: var(--soon); }
  .year.current { color: var(--emerald); }
  .path h3 { margin-top: 12px; font-family: var(--font-sans); font-size: 18px; font-weight: 600; line-height: 1.4; }
  .text { margin-top: 8px; font-size: 15px; line-height: 1.7; color: var(--body); }
  .more { margin-top: 20px; }
</style>
