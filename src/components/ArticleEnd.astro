---
// After every article and lesson: what to read next, then the newsletter.
// Articles get two "Read next" posts; lessons get the previous and next lesson in the series.
import PostCover from './PostCover.astro';
import SubscribeForm from './SubscribeForm.astro';
import { type Post, isLesson, lessonNumber, lessonNeighbours, postLabel, readNext } from '../data/blog';
interface Props {
  post: Post;
}
const { post } = Astro.props;
const lesson = isLesson(post);
const nextPosts = lesson ? [] : readNext(post, 2);
const { previous, next, number } = lessonNeighbours(post);
const pad = (n: number) => String(n).padStart(2, '0');
---
{lesson ? (
  <nav class="lesson-nav shell" aria-label="More lessons">
    <div class="ruled rows">
      <div class="ruled-grid">
        {previous ? (
          <a href={previous.href} class="step-link">
            <span class="meta">← Previous · Lesson {lessonNumber(previous)}</span>
            <span class="step-title serif">{previous.title}</span>
          </a>
        ) : (
          <a href="/learning/" class="step-link">
            <span class="meta">← The lesson series</span>
            <span class="step-title serif">All lessons</span>
          </a>
        )}
        {next ? (
          <a href={next.href} class="step-link end" data-umami-event="Read next" data-umami-event-to={next.href}>
            <span class="meta">Next · Lesson {lessonNumber(next)} →</span>
            <span class="step-title serif">{next.title}</span>
          </a>
        ) : (
          <div class="step-link end">
            <span class="meta">Next · Lesson {pad(number + 1)}</span>
            <span class="step-title serif soon"><em class="plain">Coming soon</em></span>
          </div>
        )}
      </div>
    </div>
  </nav>
) : (
  <section class="read-next shell" aria-labelledby="read-next-title">
    <h2 id="read-next-title" class="next-label">Read next</h2>
    <div class="next-grid">
      {nextPosts.map(item => (
        <a href={item.href} class="next-link" data-umami-event="Read next" data-umami-event-to={item.href}>
          <span class="next-thumb"><PostCover post={item} tone="numeral" ratio="4 / 3" sizes="160px" /></span>
          <span class="next-copy">
            <span class="meta"><span class="accent">{isLesson(item) ? postLabel(item) : `Article · ${item.category}`}</span></span>
            <span class="next-title serif">{item.title}</span>
          </span>
        </a>
      ))}
    </div>
  </section>
)}

<section class="end-news shell" aria-label="Newsletter">
  {lesson ? (
    <SubscribeForm
      id="subscribe-article"
      layout="split"
      title={next ? 'Get each new lesson' : `Get Lesson ${pad(number + 1)}`}
      text="One short email when a new lesson goes up, so we keep learning together."
    />
  ) : (
    <SubscribeForm id="subscribe-article" layout="split" title="Get the next post" />
  )}
</section>

<style>
  .read-next, .lesson-nav { padding-top: 112px; }
  .next-label { font: 400 12px/1.5 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--emerald); }
  .next-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: 40px; margin-top: 24px; padding-top: 32px; border-top: 1px solid var(--ink); }
  .next-link { display: flex; align-items: flex-start; gap: 24px; color: var(--ink); }
  .next-thumb { flex: 0 0 160px; width: 160px; }
  .next-copy { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .next-title { font-size: 28px; line-height: 1.08; transition: color 160ms ease; }
  .next-link:hover .next-title { color: var(--emerald); }

  .lesson-nav .ruled-grid { --cell-min: 320px; --cell-pad: 32px; }
  .step-link { display: flex; flex-direction: column; gap: 8px; padding-block: 32px; color: var(--ink); }
  .step-link.end { text-align: right; }
  .step-title { font-size: 34px; line-height: 1.05; transition: color 160ms ease; }
  a.step-link:hover .step-title { color: var(--emerald); }
  .step-title.soon { color: var(--soon); }
  .step-link .meta { display: block; }

  .end-news { padding-block: 96px 112px; }

  @media (max-width: 480px) {
    .next-thumb { flex-basis: 112px; width: 112px; }
    .next-title { font-size: 24px; }
  }
  @media (max-width: 700px) {
    .step-link.end { text-align: left; }
  }
</style>
