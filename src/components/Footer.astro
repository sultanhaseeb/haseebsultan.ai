---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { profile } from '../data/resume';
const pages = [
  { href: '/writing/', label: 'Writing' },
  { href: '/learning/', label: 'Lessons' },
  { href: '/projects/', label: 'Projects' },
  { href: '/experience/', label: 'Experience' },
  { href: '/about/', label: 'About' },
];
const elsewhere = [
  { href: site.social.email, label: profile.email },
  { href: site.social.linkedin, label: 'LinkedIn', external: true },
  { href: site.social.github, label: 'GitHub', external: true },
  { href: site.social.topmate, label: 'Topmate', external: true },
];
---
<footer class="site-footer">
  <div class="shell">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="wordmark"><span class="wordmark-mark" aria-hidden="true">HS</span>Haseeb Sultan</a>
        <p>{site.title} in {profile.location}. I build cloud, Kubernetes, and AI platforms, and write about what I learn.</p>
      </div>
      <nav class="footer-col" aria-labelledby="footer-pages">
        <h2 id="footer-pages">Pages</h2>
        <ul>{pages.map(page => <li><a href={page.href}>{page.label}</a></li>)}</ul>
      </nav>
      <nav class="footer-col" aria-labelledby="footer-elsewhere">
        <h2 id="footer-elsewhere">Contact</h2>
        <ul>{elsewhere.map(link => <li><a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>{link.label}{link.external && <Icon name="external" size={13} />}</a></li>)}</ul>
      </nav>
    </div>
    <div class="footer-bottom"><span>© {new Date().getFullYear()} Haseeb Sultan</span><span><a href="/rss.xml">RSS feed</a> · Built with Astro</span></div>
  </div>
</footer>
