---
// A compact dark footer on every page. The homepage passes `newsletter` to add the signup form above the links.
import SubscribeForm from './SubscribeForm.astro';
import { site } from '../data/site';
import { profile } from '../data/resume';
interface Props {
  newsletter?: boolean;
}
const { newsletter = false } = Astro.props;
const year = new Date().getFullYear();
const links = [
  { href: '/blog/', label: 'Blog' },
  { href: '/learning/', label: 'Lessons' },
  { href: '/projects/', label: 'Projects' },
  { href: site.social.linkedin, label: 'LinkedIn', external: true },
  { href: site.social.github, label: 'GitHub', external: true },
  { href: '/rss.xml', label: 'RSS' },
];
---
<footer class="site-footer">
  {newsletter ? (
    <>
      <div class="footer-news shell">
        <SubscribeForm
          id="subscribe-footer"
          tone="night"
          title="The newsletter"
          titleEm=""
          text="New articles and lessons on AI infrastructure, sent when they're published."
        />
        <nav aria-label="Footer">
          <ul class="footer-links">
            {links.map(link => <li><a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>{link.label}</a></li>)}
          </ul>
        </nav>
      </div>
      <p class="footer-bottom footer-copy shell">© {year} {site.name} · {profile.location}</p>
    </>
  ) : (
    <div class="footer-main shell">
      <a href="/" class="footer-wordmark">{site.name}<span class="dot" aria-hidden="true">.</span></a>
      <nav aria-label="Footer">
        <ul class="footer-links">
          {links.map(link => <li><a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>{link.label}</a></li>)}
        </ul>
      </nav>
      <p class="footer-copy">© {year} · {profile.location}</p>
    </div>
  )}
</footer>
