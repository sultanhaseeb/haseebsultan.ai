---
// Email signup. A plain form that posts straight to Kit (no script needed to subscribe).
// Kit adds the subscriber straight away (no confirmation email) and redirects to /subscribe/confirmed/.
// Tones: "forest" is the newsletter box, "night" sits on the dark footer, "light" is the pop-up.
// The `.subscribe-form` class and data-location are what the pop-up and Umami listen for.
import { newsletter } from '../data/site';
interface Props {
  // Unique per page, so each form's label points at its own input. Its suffix becomes data-location.
  id: string;
  title?: string;
  // Words after the title, set in italics: "Get each new post" + "by email."
  titleEm?: string;
  kicker?: string;
  text?: string;
  tone?: 'forest' | 'night' | 'light';
  // "split" puts the copy and the form side by side on wide screens; "stack" puts the form underneath.
  layout?: 'split' | 'stack';
  headingLevel?: 'h2' | 'p';
}
const {
  id,
  title = 'Get new posts',
  titleEm = 'by email.',
  kicker,
  text,
  tone = 'forest',
  layout = 'stack',
  headingLevel = 'h2',
} = Astro.props;
const Heading = headingLevel;
const inputId = `${id}-email`;
---
{newsletter.formId && (
  <div class:list={['newsletter', `newsletter-${tone}`, `newsletter-${layout}`]}>
    <div class="newsletter-copy">
      {kicker && <p class="newsletter-kicker">{kicker}</p>}
      <Heading class="newsletter-title serif" id={`${id}-title`}>{title}{titleEm && <>{' '}<em>{titleEm}</em></>}</Heading>
      {text && <p class="newsletter-text">{text}</p>}
    </div>
    <form action={newsletter.action} method="post" class="subscribe-form" aria-labelledby={`${id}-title`} data-location={id.replace(/^subscribe-/, '')}>
      <label for={inputId} class="sr-only">Email address</label>
      <input id={inputId} type="email" name="email_address" required autocomplete="email" placeholder="Your email address" />
      <button type="submit">Subscribe <span aria-hidden="true">→</span></button>
    </form>
  </div>
)}

<style>
  .newsletter-forest { padding: clamp(32px, 5vw, 56px); background: var(--forest); color: var(--forest-ink); }
  .newsletter-split { display: flex; flex-wrap: wrap; align-items: end; gap: 32px 72px; }
  .newsletter-split .newsletter-copy { flex: 1 1 420px; min-width: 0; }
  .newsletter-split .subscribe-form { flex: 1 1 360px; }
  .newsletter-stack .subscribe-form { margin-top: 24px; }

  .newsletter-kicker { margin-bottom: 14px; font: 400 12px/1.5 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--mint); }
  .newsletter-title { font-size: clamp(36px, 4vw, 52px); line-height: 1.02; letter-spacing: -.01em; color: inherit; }
  .newsletter-stack .newsletter-title { font-size: 40px; line-height: 1.05; }
  .newsletter-forest .newsletter-title em, .newsletter-night .newsletter-title em { color: var(--mint); }
  .newsletter-text { margin-top: 14px; max-width: 46ch; font-size: 15px; line-height: 1.7; color: var(--forest-body); }

  .subscribe-form { display: flex; flex-wrap: wrap; border-bottom: 1px solid currentColor; }
  .subscribe-form input {
    flex: 1 1 200px;
    min-width: 0;
    min-height: 52px;
    padding: 0;
    border: 0;
    background: transparent;
    font-size: 17px;
    color: inherit;
  }
  .subscribe-form input::placeholder { color: var(--forest-muted); opacity: 1; }
  .subscribe-form button {
    min-height: 52px;
    padding: 0 4px;
    border: 0;
    background: transparent;
    font-size: 15px;
    font-weight: 500;
    color: var(--mint);
    cursor: pointer;
    transition: color 160ms ease;
  }
  .subscribe-form button:hover { color: var(--forest-ink); }
  .subscribe-form :focus-visible { outline: 2px solid var(--mint); outline-offset: 4px; }

  /* On the dark footer. */
  .newsletter-night { color: var(--night-ink); }
  .newsletter-night .newsletter-title { font-size: 40px; line-height: 1; }
  .newsletter-night .newsletter-text { margin-top: 12px; color: var(--night-muted); }
  .newsletter-night .subscribe-form { max-width: 460px; margin-top: 22px; }
  .newsletter-night .subscribe-form input { font-size: 16px; }
  .newsletter-night .subscribe-form input::placeholder { color: var(--night-muted); }

  /* In the pop-up, on paper. */
  .newsletter-light { color: var(--ink); }
  .newsletter-light .newsletter-title { font-size: 34px; line-height: 1.05; }
  .newsletter-light .newsletter-text { color: var(--body); }
  .newsletter-light .subscribe-form input::placeholder { color: var(--muted); }
  .newsletter-light .subscribe-form button { color: var(--emerald); }
  .newsletter-light .subscribe-form button:hover { color: var(--ink); }
  .newsletter-light .subscribe-form :focus-visible { outline-color: var(--emerald); }
</style>
