---
// Email signup. A plain form that posts straight to Kit, so the site still ships no JavaScript.
// Kit then sends a confirmation email and redirects back to /subscribe/check-your-inbox/.
import { newsletter } from '../data/site';
interface Props {
  // Unique per page, so each form's label points at its own input.
  id: string;
  title?: string;
  text?: string;
  tone?: 'light' | 'dark';
}
const {
  id,
  title = 'Get new posts by email',
  text = 'One short email when I publish a new article or lesson. No spam, and you can unsubscribe at any time.',
  tone = 'light',
} = Astro.props;
const inputId = `${id}-email`;
---
{newsletter.formId && (
  <div class:list={['subscribe', `subscribe-${tone}`]}>
    <p class="subscribe-title" id={`${id}-title`}>{title}</p>
    {text && <p class="subscribe-text">{text}</p>}
    <form action={newsletter.action} method="post" class="subscribe-form" aria-labelledby={`${id}-title`}>
      <label for={inputId} class="sr-only">Email address</label>
      <input id={inputId} type="email" name="email_address" required autocomplete="email" placeholder="you@example.com" />
      <button type="submit">Subscribe</button>
    </form>
  </div>
)}

<style>
  .subscribe-title { font-family: var(--font-display); font-weight: 600; font-size: 19px; line-height: 1.3; color: var(--ink); }
  .subscribe-text { margin-top: 6px; max-width: 52ch; font-size: 15px; line-height: 1.65; color: var(--slate); }
  .subscribe-form { display: flex; gap: 8px; max-width: 460px; margin-top: 16px; }
  .subscribe-form input {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 48px;
    padding: 0 14px;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--surface);
    font-size: 15px;
    color: var(--ink);
  }
  .subscribe-form input::placeholder { color: var(--slate); opacity: .75; }
  .subscribe-form input:focus-visible { outline: 2px solid var(--signal); outline-offset: 2px; border-color: var(--signal); }
  .subscribe-form button {
    flex: none;
    min-height: 48px;
    padding: 0 20px;
    border-radius: 4px;
    background: var(--ink);
    font-size: 15px;
    font-weight: 600;
    color: var(--surface);
    cursor: pointer;
    transition: background-color 160ms ease;
  }
  .subscribe-form button:hover { background: var(--signal); }
  .subscribe-form button:focus-visible { outline: 2px solid var(--signal); outline-offset: 2px; }

  /* On the dark footer. */
  .subscribe-dark .subscribe-title { font-size: 16px; color: var(--night-ink); }
  .subscribe-dark .subscribe-text { font-size: 14px; color: var(--night-muted); }
  .subscribe-dark .subscribe-form input { border-color: var(--night-rule); background: var(--night-raised); color: var(--night-ink); }
  .subscribe-dark .subscribe-form input::placeholder { color: var(--night-muted); }
  .subscribe-dark .subscribe-form input:focus-visible { outline-color: var(--night-signal); border-color: var(--night-signal); }
  .subscribe-dark .subscribe-form button { background: var(--night-ink); color: var(--night); }
  .subscribe-dark .subscribe-form button:hover { background: var(--night-signal); }
  .subscribe-dark .subscribe-form button:focus-visible { outline-color: var(--night-signal); }

  @media (max-width: 420px) {
    .subscribe-form { flex-direction: column; }
  }
</style>
