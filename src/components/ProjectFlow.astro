---
interface Props {
  steps: string[];
  label: string;
}

const { steps, label } = Astro.props;
---
<ol class="project-flow" aria-label={label}>
  {steps.map((step, index) => (
    <li>
      <span class="step">{step}</span>
      {index < steps.length - 1 && <span class="arrow" aria-hidden="true">→</span>}
    </li>
  ))}
</ol>

<style>
  .project-flow { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; margin: 0; padding: 0; list-style: none; font: 400 12px/1.5 var(--font-utility); }
  .project-flow li { display: inline-flex; align-items: center; gap: 8px; }
  .step { padding: 4px 9px; border-radius: 3px; background: var(--signal-soft); color: var(--ink); }
  .arrow { color: var(--signal); }
</style>
