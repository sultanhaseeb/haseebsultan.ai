---
// An architecture flow: steps joined by arrows. "pill" fills each step, "dashed" outlines it (for work in
// progress), and "text" is a plain mono line for dense grids.
interface Props {
  steps: string[];
  label: string;
  variant?: 'pill' | 'dashed' | 'text';
}
const { steps, label, variant = 'pill' } = Astro.props;
---
<ol class:list={['flow', `flow-${variant}`]} aria-label={label}>
  {steps.map((step, index) => (
    <li>
      <span class:list={[variant === 'text' ? 'step' : 'pill', { dashed: variant === 'dashed' }]}>{step}</span>
      {index < steps.length - 1 && <span class="arrow" aria-hidden="true">→</span>}
    </li>
  ))}
</ol>

<style>
  .flow-pill, .flow-dashed { font-size: 12px; }
  .flow-pill .pill, .flow-dashed .pill { padding: 6px 10px; }
  .flow-text { gap: 4px 12px; font-size: 12px; line-height: 1.8; color: var(--muted); }
  .flow-text li { gap: 12px; }
</style>
