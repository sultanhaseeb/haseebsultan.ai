---
import PageLayout from '../layouts/PageLayout.astro';
import { profile, expertise, experience, additionalSkills } from '../data/resume';
---
<PageLayout title="Experience & Skills" label="Since 2019" description="Haseeb Sultan’s career experience and skills in DevOps, cloud architecture, Kubernetes, MLOps, and LLMOps." intro={profile.summary}>
  <dl slot="head" class="profile-facts">
    <div><dt>Current role</dt><dd>{profile.title}</dd></div>
    <div><dt>Location</dt><dd>{profile.location}</dd></div>
    <div><dt>Email</dt><dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd></div>
  </dl>

  <section id="career" class="h-section" aria-labelledby="career-title">
    <div class="h-grid">
      <h2 id="career-title" class="h-label">Career</h2>
      <ol class="career rule-top">
        {experience.map(job => (
          <li class="job">
            <div class="job-head">
              <p class="period">{job.period}</p>
              <h3>{job.role}</h3>
              <p class="focus">{job.focus}</p>
            </div>
            <ul class="highlights">{job.highlights.map(highlight => <li>{highlight}</li>)}</ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="expertise" class="h-section" aria-labelledby="expertise-title">
    <div class="h-grid">
      <h2 id="expertise-title" class="h-label">Expertise</h2>
      <div>
        <ul class="chip-list">{expertise.map(item => <li class="chip">{item}</li>)}</ul>
        <div class="skills">
          {additionalSkills.map(skill => <article><h3>{skill.title}</h3><p>{skill.description}</p></article>)}
        </div>
        <p class="more">See also <a href="/projects/">projects</a>, <a href="/about/#credentials">certifications</a>, and <a href="/about/#education">education</a>.</p>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .profile-facts { display: flex; flex-wrap: wrap; gap: 16px 48px; margin: 32px 0 0; }
  .profile-facts dt { font: 500 11px/1.5 var(--font-utility); letter-spacing: .08em; text-transform: uppercase; color: var(--slate); }
  .profile-facts dd { margin: 6px 0 0; font-size: 15px; font-weight: 500; overflow-wrap: anywhere; }
  .profile-facts a { color: var(--signal); }
  .profile-facts a:hover { color: var(--signal-strong); }

  .career { margin: 0; padding: 0; list-style: none; }
  .job { display: grid; grid-template-columns: minmax(0, .75fr) minmax(0, 1.5fr); gap: 40px; padding-block: 34px; border-bottom: 1px solid var(--rule); }
  .period { font: 400 12px/1.5 var(--font-utility); color: var(--signal); font-variant-numeric: tabular-nums; }
  .job h3 { margin-top: 8px; font-size: 20px; }
  .focus { margin-top: 8px; font-size: 14px; line-height: 1.6; color: var(--slate); }
  .highlights { display: grid; gap: 12px; margin: 0; padding: 0; list-style: none; }
  .highlights li { position: relative; padding-left: 20px; font-size: 15px; line-height: 1.7; color: #344053; }
  .highlights li::before { content: ''; position: absolute; left: 0; top: .72em; width: 8px; height: 1px; background: var(--slate); }

  .skills { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; margin-top: 36px; padding-top: 28px; border-top: 1px solid var(--rule); }
  .skills h3 { font-size: 17px; }
  .skills p { margin-top: 8px; font-size: 15px; line-height: 1.7; color: var(--slate); }
  .more { margin-top: 32px; font-size: 14px; color: var(--slate); }
  .more a { color: var(--signal); text-decoration: underline; text-underline-offset: 3px; }

  @media (max-width: 760px) {
    .job { grid-template-columns: 1fr; gap: 18px; padding-block: 28px; }
    .skills { grid-template-columns: 1fr; gap: 24px; }
  }
</style>
