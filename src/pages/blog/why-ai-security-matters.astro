  .bank-name { flex: 0 0 180px; }
  .bank-name strong { display: block; }
  .bank-stance { font: 400 12px/1.5 var(--font-mono); color: var(--emerald); }
  .bank-moves p { flex: 1 1 320px; margin: 0 !important; }

  .compare { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px !important; }
  .compare div { flex: 1 1 240px; padding: 28px; border: 1px solid var(--rule); background: var(--paper-raised); }
  .compare dt { font: 400 12px/1.5 var(--font-mono); color: var(--muted); }
  .compare dd { margin-top: 10px; font-size: 28px; line-height: 1.15; color: var(--ink); }
  .compare .compare-agent { border-color: var(--forest); background: var(--forest); }
  .compare .compare-agent dt { color: var(--mint); }
  .compare .compare-agent dd { color: var(--forest-ink); }

  .worldwide { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr)); gap: 12px; margin-top: 24px !important; padding: 0 !important; list-style: none !important; font-size: 15px; line-height: 1.65; }
  .worldwide li { margin: 0 !important; padding: 24px; border-top: 2px solid var(--ink); background: var(--paper-raised); }
  .worldwide-country { font: 400 11px/1.5 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--emerald); }
  .worldwide-bank { margin-top: 6px !important; font-weight: 600; color: var(--ink); }
  .worldwide li p + p:last-child { margin-top: 8px; }

  .checklists { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px !important; font-size: 15px; line-height: 1.65; }
  .checklist { flex: 1 1 260px; padding: 28px; border: 1px solid var(--rule); }
  .checklist h3 { margin: 0; font-family: var(--font-sans); font-size: 16px; font-weight: 600; line-height: 1.5; }
  .checklist ul { margin-top: 14px; padding: 0; list-style: none; }
  .checklist li { position: relative; padding-left: 22px; }
  .checklist li + li { margin-top: 10px; }
  .checklist li::before { content: '✓'; position: absolute; left: 0; color: var(--emerald); }
</style>
