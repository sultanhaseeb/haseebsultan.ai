---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="افسانچہ | Haseeb Sultan" description="حسیب سلطان کے اردو افسانچے۔">
  <Header />
  <main id="main" class="shell hobby-page" lang="ur" dir="rtl">
    <h1>افسانچہ</h1>
    <div class="hobby-stories">
      <article aria-labelledby="waiting-title">
        <h2 id="waiting-title">انتظار کا آخری پہر</h2>
        <p>کل رات میں صبح کے چار بجے سویا۔<br />
اس لیے نہیں کہ نیند نہیں آ رہی تھی،<br />
بلکہ اس لیے کہ نیند آنے کی کوئی وجہ نہیں تھی۔<br />
رات کافی پہلے ختم ہو چکی تھی۔<br />
بس صبح ہونے میں کچھ وقت باقی تھا۔<br />
میں کھڑکی کے پاس بیٹھا شہر کو دیکھتا رہا۔ چند کھڑکیوں میں اب بھی روشنیاں تھیں۔ میں سوچ رہا تھا، ان روشنیوں کے پیچھے کون جاگ رہا ہوگا؟<br />
کوئی کسی کے انتظار میں،<br />
کوئی کسی کی یاد میں،<br />
اور شاید کوئی میری طرح—بلا وجہ۔<br />
فون میز پر الٹا پڑا تھا۔<br />
کسی کے پیغام کا انتظار نہیں تھا، پھر بھی کبھی کبھی اسے اٹھا کر دیکھ لیتا۔<br />
عجیب عادت ہے انسان کی۔<br />
جن دروازوں سے کسی کے آنے کی امید نہ ہو، انہیں بھی بار بار دیکھتا رہتا ہے۔<br />
چار بجنے میں چند منٹ باقی تھے۔<br />
میں نے پردہ کھینچا، فون ایک طرف رکھا اور بستر پر لیٹ گیا۔<br />
نیند آ گئی۔<br />
شاید اس لیے نہیں کہ رات ختم ہو گئی تھی—<br />
بلکہ اس لیے کہ انتظار ختم ہو گیا تھا۔</p>
      </article>
      <article aria-labelledby="dream-title">
        <h2 id="dream-title">ممنوعہ خواب</h2>
        <p>آج خواب میں وہ آیا،<br />
جسے خواب میں آنے کی بھی اجازت نہیں تھی۔<br />
نہ اُس نے کچھ کہا،<br />
نہ میں نے کوئی سوال کیا۔<br />
بس کچھ دیر میرے سامنے بیٹھا رہا،<br />
جیسے ہم دونوں جانتے ہوں کہ یہ ملاقات نہیں ہونی چاہیے تھی۔<br />
پھر جاتے ہوئے اُس نے مجھے جگا دیا۔<br />
میں نے آنکھیں کھولیں تو کمرے میں وہی رات تھی،<br />
وہی خاموشی، وہی تنہائی۔<br />
بس ایک بات سمجھ نہیں آئی—<br />
وہ مجھے جگا کیسے گیا؟<br />
میں تو سویا ہی نہیں تھا۔</p>
      </article>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  @font-face {
    font-family: 'Noto Nastaliq Urdu';
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
    src: url('/fonts/noto-nastaliq-urdu-variable.ttf') format('truetype');
  }

  .hobby-page {
    max-width: 760px;
    padding-block: 64px 80px;
    font-family: 'Noto Nastaliq Urdu', 'Urdu Typesetting', serif;
    text-align: start;
  }

  .hobby-page h1 {
    font-family: inherit;
    font-size: clamp(38px, 6vw, 54px);
    font-weight: 500;
    line-height: 2.4;
    letter-spacing: normal;
    margin-bottom: 40px;
  }

  .hobby-stories article {
    padding-block: 38px;
    border-top: 1px solid var(--color-line);
  }

  .hobby-stories h2 {
    font-family: inherit;
    font-size: clamp(26px, 4vw, 34px);
    font-weight: 600;
    line-height: 2.4;
    letter-spacing: normal;
    margin-bottom: 24px;
  }

  .hobby-stories p {
    font-size: clamp(19px, 2.5vw, 23px);
    line-height: 2.8;
    overflow-wrap: break-word;
  }

  @media (max-width: 767px) {
    .hobby-page { padding-block: 32px 48px; }
    .hobby-page h1 { margin-bottom: 24px; }
    .hobby-stories article { padding-block: 28px; }
  }
</style>
