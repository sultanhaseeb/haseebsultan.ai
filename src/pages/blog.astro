---
import PageLayout from '../layouts/PageLayout.astro';
import PostList from '../components/PostList.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import { posts } from '../data/blog';
---
<PageLayout
  title="Blog"
  size="xl"
  kicker={['Articles & lessons', `${posts.length} posts`, { label: 'RSS feed', href: '/rss.xml' }]}
  description="Haseeb Sultan’s blog: articles on where AI and its infrastructure are heading, and step-by-step lessons on AI engineering, from AI agents and MCP to LLMOps."
  intro="What I think about AI and the infrastructure underneath it, plus numbered lessons that break down new ideas in AI engineering, step by step."
>
  <Fragment slot="heading">The <em>Blog</em></Fragment>
  <PostList posts={posts} />
  <section id="subscribe" class="newsletter-section shell" aria-label="Newsletter">
    <SubscribeForm
      id="subscribe-blog"
      layout="split"
      kicker="Newsletter"
      title="Get each new post"
      text="One short email when a new lesson or article goes up. No spam, and you can unsubscribe at any time."
    />
  </section>
</PageLayout>

<style>
  .newsletter-section { padding-block: var(--section-gap); }
</style>
