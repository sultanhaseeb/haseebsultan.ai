---
import { Image } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import Journey from '../components/Journey.astro';
import portrait from '../assets/images/haseeb.jpg';
import { profile } from '../data/resume';
import { site } from '../data/site';

const values = [
  { title: 'Guardrails that hold when things go wrong', text: 'Limits belong in the platform, not in a checklist or a prompt. In k8s-agent the AI agent’s permissions come from Kubernetes RBAC, so they hold even when the model gets it wrong.' },
  { title: 'Automate it, then write it down', text: 'Everything I build runs on infrastructure as code and CI/CD, and comes with documentation the next engineer can actually use.' },
  { title: 'Cost is part of the design', text: 'A platform should be affordable to run, not just to build. On Azure I cut infrastructure costs by up to 45% through resource management, scaling, and reserved instances.' },
];
---
<PageLayout
  title="About"
  description="Haseeb Sultan is an AI Platform Engineer in Dubai: his story from full-stack development to AI platforms, what he cares about, and how to get in touch."
>
  <section slot="hero" class="about-hero shell" aria-labelledby="about-title">
    <div class="kicker-strip"><span>About</span><span>{site.title}</span><span>{profile.location}</span></div>
    <div class="hero-main">
      <div class="hero-copy">
        <h1 id="about-title">Hi, I'm <em>Haseeb.</em></h1>
        <p class="hero-lede serif">I'm an {site.title} in {profile.location}. I build the infrastructure AI systems run on, and the guardrails that let AI agents act on real systems safely.</p>
      </div>
      <figure class="hero-photo">
        <Image
          src={portrait}
          alt="Haseeb Sultan smiling outdoors, wearing a navy blazer and white shirt"
          widths={[320, 360, 720]}
          sizes="(max-width: 400px) calc(100vw - 40px), 360px"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <section id="story" class="section shell" aria-labelledby="story-title">
    <div class="story">
      <div class="story-head">
        <p class="sec-label">§ 01 · My story</p>
        <h2 id="story-title">How I got here.</h2>
      </div>
      <div class="story-text">
        <p class="drop-cap">I started in 2019 as a full-stack developer, building products with React, Node.js, and MySQL. In 2020 I moved into DevOps, and I have worked on the platforms underneath applications ever since: cloud, Kubernetes, delivery pipelines, and security.</p>
        <p>Since then I have migrated more than 100 virtual machines and 25 Kubernetes clusters to Azure, built DevSecOps pipelines for more than 23 microservices, cut Azure infrastructure costs by up to 45%, and led a team of eight. The work has taken me across Azure, AWS, and Google Cloud, and into fintech, healthcare, and banking.</p>
        <blockquote class="story-quote serif">Who is allowed to do what, how every action is recorded, and what happens when something goes wrong.</blockquote>
        <p>Now I focus on AI platforms. AI agents are starting to act on real systems, and those are the questions I have worked on for years. I am most interested in taking AI systems from experiment to secure, reliable production. <a href="/projects/k8s-agent/">k8s-agent</a>, my open-source Kubernetes agent, is that idea in code.</p>
        <p>I also write. On my <a href="/blog/">blog</a> I share what I think about where AI is heading, and my <a href="/learning/">lessons</a> break down new ideas in AI engineering so you can learn them with me. If you want to go deeper on something, you can <a href={site.social.topmate} target="_blank" rel="noopener noreferrer">book a one-to-one session</a> with me on Topmate.</p>
      </div>
    </div>
  </section>

  <section id="values" class="band values-band" aria-labelledby="values-title">
    <div class="band-inner shell">
      <div class="sec-head">
        <p class="sec-label">§ 02 · What I care about</p>
        <h2 id="values-title">How I like <em>to build.</em></h2>
      </div>
      <div class="ruled values">
        <ol class="ruled-grid">
          {values.map((value, index) => (
            <li>
              <span class="value-no serif" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <h3>{value.title}</h3>
              <p>{value.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <Journey />

  <section id="contact" class="contact shell" aria-labelledby="contact-title">
    <p class="sec-label">§ 04 · Contact</p>
    <h2 id="contact-title">Get in <em>touch.</em></h2>
    <div class="contact-row">
      <p class="contact-copy">The quickest way to reach me is email. You can also connect with me on LinkedIn, or book a one-to-one session on Topmate.</p>
      <div class="btn-row contact-actions">
        <a class="btn btn-primary btn-lg" href={`mailto:${profile.email}`}>{profile.email}</a>
        <a class="btn btn-secondary btn-lg" href={site.social.linkedin} target="_blank" rel="noopener noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7"></path></svg>
          Connect on LinkedIn <span aria-hidden="true">↗</span>
        </a>
        <a class="btn btn-secondary btn-lg" href={site.social.topmate} target="_blank" rel="noopener noreferrer">Book on Topmate <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .about-hero { padding-top: clamp(48px, 7vw, 88px); }
  .hero-main { display: flex; flex-wrap: wrap; align-items: end; gap: 48px 72px; margin-top: 48px; }
  .hero-copy { flex: 999 1 560px; min-width: 0; }
  .hero-copy h1 { font-size: clamp(72px, 11vw, 168px); line-height: .88; letter-spacing: -.03em; }
  .hero-lede { margin-top: 36px; max-width: 46ch; font-size: clamp(26px, 2.4vw, 34px); line-height: 1.25; color: var(--ink-soft); }
  .hero-photo { flex: 1 1 280px; max-width: 360px; }
  .hero-photo :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 30%; background: var(--placeholder); }

  .story { display: flex; flex-wrap: wrap; gap: 24px 72px; }
  .story-head { flex: 1 1 260px; }
  .story-head h2 { margin-top: 16px; font-size: clamp(36px, 4vw, 56px); }
  .story-text { flex: 2 1 560px; min-width: 0; max-width: 68ch; display: flex; flex-direction: column; gap: 20px; font-size: 18px; line-height: 1.75; color: var(--ink-soft); }
  .story-text a { color: var(--emerald); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .story-text a:hover { color: var(--ink); }
  .story-quote { margin-block: 16px; padding: 8px 0 8px 28px; border-left: 2px solid var(--emerald); font-size: clamp(26px, 3vw, 32px); font-style: italic; line-height: 1.2; color: var(--ink); }

  .values-band { margin-top: var(--section-gap); }
  .values { margin-top: 48px; }
  .values .ruled-grid { --cell-min: 280px; --cell-pad: 32px; }
  .values li { padding-top: 32px; }
  .value-no { font-size: 64px; line-height: 1; color: var(--mint); }
  .values h3 { margin-top: 16px; font-size: 30px; line-height: 1.1; }
  .values p { margin-top: 14px; font-size: 15px; line-height: 1.7; color: var(--forest-body); }

  .contact { padding-block: clamp(96px, 12vw, 140px) var(--section-gap); }
  .contact h2 { margin-top: 20px; font-size: clamp(64px, 9vw, 136px); line-height: .92; letter-spacing: -.025em; }
  .contact-row { display: flex; flex-wrap: wrap; align-items: end; gap: 32px 72px; margin-top: 40px; }
  .contact-copy { flex: 1 1 380px; max-width: 44ch; font-size: 18px; line-height: 1.65; color: var(--body); }
  .contact-actions { flex: 1 1 380px; }
</style>
