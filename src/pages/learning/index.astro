---
import PageLayout from '../../layouts/PageLayout.astro';
import PostCover from '../../components/PostCover.astro';
import SubscribeForm from '../../components/SubscribeForm.astro';
import { lessons, lessonNumber } from '../../data/blog';
import { topics } from '../../data/site';
import { profile } from '../../data/resume';
import { formatDate } from '../../utils/date';

// Newest lesson first; numbers still follow publication order.
const newestFirst = [...lessons].reverse();
const suggestHref = `mailto:${profile.email}?subject=${encodeURIComponent('Lesson idea')}`;
const count = lessons.length;
---
<PageLayout
  title="Let's learn together"
  kicker={['The lesson series', `${count} ${count === 1 ? 'lesson' : 'lessons'} so far`, 'AI engineering, step by step']}
  description="Step-by-step lessons on AI engineering by Haseeb Sultan: AI agents, MCP, LLMOps, and AI infrastructure, explained so you can learn alongside him."
  intro="Each lesson breaks down a new idea in AI engineering, step by step, so you can learn it alongside me, one topic at a time."
>
  <Fragment slot="heading">Let's learn <em>together.</em></Fragment>

  <section class="lessons-section shell" aria-labelledby="lessons-title">
    <h2 id="lessons-title" class="sr-only">Lessons</h2>
    <ol class="lessons">
      {newestFirst.map((lesson, index) => (
        <li>
          <a href={lesson.href} class="lesson">
            <span class:list={['numeral', { newest: index === 0 }]} aria-hidden="true">{lessonNumber(lesson)}</span>
            <div class="lesson-copy">
              <p class="meta">
                <span class="sr-only">Lesson {lessonNumber(lesson)}.</span>
                {index === 0 && <span class="accent">Newest</span>}
                <span>{lesson.tags?.length ? lesson.tags.join(' · ') : lesson.category}</span>
                <time datetime={lesson.published}>{formatDate(lesson.published)}</time>
              </p>
              <h3>{lesson.title}</h3>
              <p class="desc">{lesson.description}</p>
            </div>
            <PostCover post={lesson} tone="forest" ratio="4 / 3" class="lesson-cover" sizes="(max-width: 760px) calc(100vw - 40px), 300px" />
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="coming shell" aria-labelledby="coming-title">
    <div class="topics">
      <p class="sec-label">§ Coming up</p>
      <h2 id="coming-title">Topics on the list.</h2>
      <ul class="chip-list">{topics.map(topic => <li class="chip">{topic}</li>)}</ul>
      <p class="suggest">Is there something you want us to learn next? Email me at <a href={suggestHref}>{profile.email}</a> with your idea.</p>
    </div>
    <div id="subscribe" class="news">
      <SubscribeForm
        id="subscribe-lessons"
        title="Get each new lesson"
        text="One short email when a new lesson or article goes up, so we keep learning together. No spam, and you can unsubscribe at any time."
      />
    </div>
  </section>
</PageLayout>

<style>
  .lessons-section { padding-top: 72px; }
  .lessons { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--ink); }
  .lessons > li { border-bottom: 1px solid var(--rule); }
  .lesson { display: flex; flex-wrap: wrap; align-items: center; gap: 24px 48px; padding-block: 40px; color: var(--ink); }
  .numeral { flex: 0 0 140px; font-family: var(--font-serif); font-size: 120px; line-height: .8; color: var(--faint); }
  .numeral.newest { color: var(--emerald); }
  .lesson-copy { flex: 2 1 420px; min-width: 0; }
  .lesson h3 { margin-top: 10px; font-size: clamp(32px, 3.4vw, 48px); line-height: 1.04; transition: color 160ms ease; }
  .lesson:hover h3 { color: var(--emerald); }
  .desc { margin-top: 12px; max-width: 60ch; font-size: 16px; line-height: 1.7; color: var(--body); }
  .lesson :global(.lesson-cover) { flex: 1 1 260px; max-width: 360px; }

  .coming { display: flex; flex-wrap: wrap; gap: 48px 72px; padding-block: var(--section-gap); }
  .topics { flex: 1 1 460px; min-width: 0; }
  .topics h2 { margin-top: 16px; font-size: clamp(38px, 4.4vw, 60px); }
  .topics .chip-list { margin-top: 32px; }
  .suggest { margin-top: 28px; max-width: 56ch; font-size: 15px; line-height: 1.7; color: var(--body); }
  .suggest a { color: var(--emerald); text-decoration: underline; text-underline-offset: 3px; overflow-wrap: anywhere; }
  .news { flex: 1 1 400px; min-width: 0; }

  @media (max-width: 560px) {
    .numeral { flex-basis: 100%; font-size: 96px; }
  }
</style>
