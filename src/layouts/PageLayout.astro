---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props { title: string; description: string; intro?: string; label?: string; }
const { title, description, intro, label = title } = Astro.props;
---
<BaseLayout title={`${title} | Haseeb Sultan`} description={description}>
  <Header />
  <main id="main">
    <header class="page-head shell">
      <div class="h-grid">
        <p class="h-label">{label}</p>
        <div>
          <h1>{title}</h1>
          {intro && <p class="lede">{intro}</p>}
          <slot name="head" />
        </div>
      </div>
    </header>
    <div class="page-body shell">
      <slot />
    </div>
  </main>
  <Footer />
</BaseLayout>
