---
import BaseLayout from './BaseLayout.astro';
import { specDrivenArticle as article } from '../data/writing';
import { readerPages } from '../data/spec-driven-reader';
import '../styles/reader.css';
interface Props { page: 1 | 2; }
const { page } = Astro.props;
const current = readerPages[page - 1];
const previous = readerPages.find(item => item.number === page - 1);
const next = readerPages.find(item => item.number === page + 1);
---
<BaseLayout title={`${current.title} — Spec-Driven Development | Haseeb Sultan`} description={current.description} article={{ published: article.published, image: article.image, headline: `${article.title}: ${current.title}` }}>
  <div class="reader-frame">
    <header class="reader-toolbar">
      <a href="/" class="wordmark" aria-label="Haseeb Sultan home">Haseeb Sultan<span aria-hidden="true">.</span></a>
      <a href="/writing/" class="reader-back">← Back to writing</a>
    </header>
    <main id="main" class="reader-shell">
      <div class="reader-book-heading">
        <p>Spec-Driven Development</p>
        <span>A visual guide · {readerPages.length} pages</span>
      </div>
      <article class="reader-paper" aria-labelledby="reader-page-title">
        <slot name="visual" />
        <div class="reader-content">
          <p class="reader-chapter">{String(page).padStart(2, '0')} <span aria-hidden="true">/</span> {current.title}</p>
          <slot />
        </div>
        <nav class="reader-pagination" aria-label="Reading pages">
          {previous
            ? <a href={previous.href} rel="prev" class="reader-page-link reader-previous" aria-label={`Previous page: ${previous.title}`}><span aria-hidden="true">←</span> Previous</a>
            : <span class="reader-page-link reader-previous is-disabled" role="link" aria-disabled="true"><span aria-hidden="true">←</span> Previous</span>}
          <ol class="reader-page-numbers" aria-label="Choose a page">
            {readerPages.map(item => <li><a href={item.href} aria-label={`Page ${item.number}: ${item.title}`} aria-current={item.number === page ? 'page' : undefined}>{item.number}</a></li>)}
          </ol>
          {next
            ? <a href={next.href} rel="next" class="reader-page-link reader-next" aria-label={`Next page: ${next.title}`}>Next <span aria-hidden="true">→</span></a>
            : <span class="reader-page-link reader-next is-disabled" role="link" aria-disabled="true">Next <span aria-hidden="true">→</span></span>}
        </nav>
      </article>
      <div class="reader-footnote"><span>Haseeb Sultan</span><span>Page {page} of {readerPages.length}{!next && ' · End of this preview'}</span></div>
    </main>
  </div>
</BaseLayout>
