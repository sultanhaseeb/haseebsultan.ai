---
import '../styles/global.css';
import { site } from '../data/site';
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  article?: { published: string; image: string; headline: string };
}
const {
  title = `${site.name} — ${site.title}`,
  description = site.description,
  canonical = new URL(Astro.url.pathname, Astro.site).href,
  article,
} = Astro.props;
const articleImage = article ? new URL(article.image, Astro.site).href : undefined;
const structuredData = article ? {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: article.headline,
  description,
  datePublished: article.published,
  image: articleImage,
  author: { '@type': 'Person', name: site.name, url: Astro.site?.href },
  mainEntityOfPage: canonical,
} : {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.title,
  url: Astro.site?.href,
  image: new URL('/images/haseeb.jpg', Astro.site).href,
  description,
  knowsAbout: ['AI Platforms', 'DevOps', 'Kubernetes', 'LLMOps', 'Agentic AI', 'MCP', 'AI Security'],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafbfc" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/inter-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="HaseebSultan.ai" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {article && <meta property="article:published_time" content={article.published} />}
    {articleImage && <meta property="og:image" content={articleImage} />}
    {articleImage && <meta name="twitter:image" content={articleImage} />}
    <meta name="twitter:card" content={article ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
  </body>
</html>
